                                </td>
                                <td>
                                    <span class="badge badge-${o.status}"><i class="${statusIcon}"></i> ${o.status}</span>
                                </td>
                                <td>
                                    <span class="badge ${cbClass}"><i class="${cbIcon}"></i> ${cbStatus === 'success' ? _t('sent') : (cbStatus === 'failed' ? _t('failed') : _t('pending'))}</span>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 0.15rem;">
                                        <span style="font-weight: 500; color: #334155;">${formattedDate}</span>
