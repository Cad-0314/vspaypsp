            async function resendCallback(orderId) {
                if (!confirm(_t('confirm_resend_callback'))) return;
                try {
                    const res = await fetch(`/api/merchant/callback/${orderId}`, { method: 'POST' });
                    const data = await res.json();
                    if (data.success) {
                        const status = data.isOk ? _t('callback_ok') : _t('callback_error');
                        showToast(`${_t('callback_sent')}: ${status} (HTTP ${data.httpCode})`, data.isOk ? 'success' : 'warning');
                    } else {
                        showToast(data.message || _t('callback_failed'), 'error');
                    }
                } catch (e) {
                    showToast(e.message, 'error');
                }
            }

            // IP Whitelist Management
            let currentIps = [];
            let pendingIpAction = null;

            async function loadIps() {
                try {
                    const res = await fetch('/api/merchant/ips');
                    const data = await res.json();
                    if (data.success) {
                        currentIps = data.ips;
                        renderIpList(data.ips);
                    }
                } catch (e) {
                    document.getElementById('ip-list').innerHTML = '<div style="color: #ff4d4f;">' + _t('error_loading') + '</div>';
                }
            }

            function renderIpList(ips) {
                const container = document.getElementById('ip-list');
                if (ips.length === 0) {
                    container.innerHTML = `
                    <div style="padding: 1rem; background: #f5f5f5; border-radius: 4px; color: var(--text-muted); text-align: center;">
                        <i class="ri-global-line" style="font-size: 1.5rem;"></i><br>
                        ${_t('no_ips_whitelisted')}
                    </div>`;
                    return;
                }
                container.innerHTML = ips.map(ip => `
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem; background: #f5f5f5; border-radius: 4px; margin-bottom: 0.5rem;">
                    <span style="font-family: monospace;">${ip}</span>
                    <button class="btn" style="background: #fff2f0; color: #ff4d4f; padding: 0.25rem 0.5rem; font-size: 0.75rem;" onclick="showRemoveIpModal('${ip}')">
                        <i class="ri-delete-bin-line"></i> ${_t('remove')}
                    </button>
                </div>
            `).join('');
            }

            function showAddIpModal() {
                const ip = document.getElementById('new-ip-input').value.trim();
                if (!ip) { showToast(_t('enter_ip'), 'error'); return; }
                const ipRegex = /^(\d{1,3}\.){3}\d{1,3}$/;
                if (!ipRegex.test(ip)) { showToast(_t('invalid_ip'), 'error'); return; }
                pendingIpAction = { action: 'add', ip: ip };
                document.getElementById('ip-modal-title').innerText = _t('add_ip');
                document.getElementById('ip-modal-desc').innerText = _t('add_ip_desc') + ': ' + ip;
                document.getElementById('totp-input').value = '';
                document.getElementById('ip-modal').classList.add('active');
            }

            function showRemoveIpModal(ip) {
                pendingIpAction = { action: 'remove', ip: ip };
                document.getElementById('ip-modal-title').innerText = _t('remove_ip');
                document.getElementById('ip-modal-desc').innerText = _t('remove_ip_desc') + ': ' + ip;
                document.getElementById('totp-input').value = '';
                document.getElementById('ip-modal').classList.add('active');
            }

            function closeIpModal() {
                document.getElementById('ip-modal').classList.remove('active');
                pendingIpAction = null;
            }

            async function confirmSecurityAction() {
                if (!pendingIpAction) return;
                const totpCode = document.getElementById('totp-input').value.trim();
                if (!totpCode || totpCode.length !== 6) { showToast(_t('enter_2fa_code'), 'error'); return; }

                if (pendingIpAction.action === 'regenerate_key') {
                    try {
                        const res = await fetch('/api/merchant/credentials/regenerate', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ totpCode })
                        });
                        const data = await res.json();
                        if (data.success) {
                            showToast(data.message, 'success');
                            const secretEl = document.getElementById('secret-blur');
                            secretEl.innerText = data.newSecret;
                            secretEl.classList.remove('blur-text');
                            document.getElementById('reveal-hint').style.display = 'none';
                            closeIpModal();
                        } else {
                            showToast(data.error, 'error');
                        }
                    } catch (e) { showToast(_t('network_error'), 'error'); }
                    return;
                }

                const endpoint = pendingIpAction.action === 'add' ? '/api/merchant/ips/add' : '/api/merchant/ips/remove';
                try {
                    const res = await fetch(endpoint, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ip: pendingIpAction.ip, totpCode: totpCode })
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast(data.message, 'success');
                        currentIps = data.ips;
                        renderIpList(data.ips);
                        document.getElementById('new-ip-input').value = '';
                        closeIpModal();
                    } else {
                        showToast(data.error, 'error');
                    }
                } catch (e) {
                    showToast(_t('network_error'), 'error');
                }
            }

            function showRegenKeyModal() {
                pendingIpAction = { action: 'regenerate_key' };
                document.getElementById('ip-modal-title').innerText = _t('regenerate_secret');
                document.getElementById('ip-modal-desc').innerText = _t('regenerate_desc');
                document.getElementById('totp-input').value = '';
                document.getElementById('ip-modal').classList.add('active');
            }

            // Security Settings Functions
            async function changePassword(e) {
                e.preventDefault();
                const currentPassword = document.getElementById('current-password').value;
                const newPassword = document.getElementById('new-password').value;
                const confirmPassword = document.getElementById('confirm-password').value;

                if (newPassword !== confirmPassword) {
                    showToast(_t('passwords_not_match'), 'error');
                    return;
                }

                if (newPassword.length < 6) {
                    showToast(_t('password_too_short'), 'error');
                    return;
                }

                try {
                    const res = await fetch('/api/merchant/change-password', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ currentPassword, newPassword })
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast(_t('password_updated'));
                        document.getElementById('current-password').value = '';
                        document.getElementById('new-password').value = '';
                        document.getElementById('confirm-password').value = '';
                    } else {
                        showToast(data.error || _t('password_update_failed'), 'error');
                    }
                } catch (err) {
                    showToast(_t('error_submitting'), 'error');
                }
            }

            async function reset2FA() {
                if (!confirm(_t('reset_2fa_confirm'))) {
                    return;
                }

                try {
                    const res = await fetch('/api/merchant/reset-2fa', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast(_t('reset_2fa_success'));
                    } else {
                        showToast(data.error || _t('reset_2fa_failed'), 'error');
                    }
                } catch (err) {
                    showToast(_t('error_submitting'), 'error');
                }
            }
        </script>
    </div> <!-- content-scroll -->
    </main>
    </div> <!-- dashboard-container -->

    <!-- Order Details Modal -->
    <div id="order-detail-modal" class="modal">
        <div class="modal-content"
            style="max-width: 500px; padding: 0; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);">
            <div
                style="background: white; padding: 1.25rem 1.5rem; border-bottom: 1px solid #F3F4F6; display: flex; justify-content: space-between; align-items: center;">
                <h3
                    style="margin: 0; font-size: 1.125rem; font-weight: 700; color: #111827; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="ri-file-list-3-line" style="color: #3B82F6;"></i>
                    <%= t('order_details') %>
                </h3>
                <button onclick="closeOrderDetailModal()"
                    style="background: #F3F4F6; border: none; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #6B7280; transition: all 0.2s;"
                    onmouseover="this.style.background='#E5E7EB';this.style.color='#374151'"
                    onmouseout="this.style.background='#F3F4F6';this.style.color='#6B7280'">
                    <i class="ri-close-line" style="font-size: 1.25rem;"></i>
                </button>
            </div>
            <div id="order-detail-content" style="padding: 1.5rem; max-height: 70vh; overflow-y: auto;">
                <div style="text-align: center; padding: 2rem; color: #9CA3AF;">
                    <i class="ri-loader-4-line ri-spin"
                        style="font-size: 2rem; margin-bottom: 0.5rem; display: block;"></i>
                    <span>Loading details...</span>
                </div>
            </div>
        </div>
    </div>
</body>

</html>