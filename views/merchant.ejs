                                    <th>
                                        <%= t('amount') || 'Amount' %>
                                    </th>
                                    <th>
                                        <%= t('status') || 'Status' %>
                                    </th>
                                    <th>
                                        <%= t('details') || 'Details' %>
                                    </th>
                                    <th>
                                        <%= t('created') || 'Created' %>
                                    </th>
                                    <th>
                                        <%= t('updated') || 'Updated' %>
