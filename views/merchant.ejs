                        <div class="card-body" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center;">
                            <input type="text" id="payout-filter-search" class="form-control"
                                placeholder="<%= t('search_order') || 'Search Order ID...' %>"
