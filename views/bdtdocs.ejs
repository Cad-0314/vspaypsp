            <p style="margin-top:.5rem"><a href="/apidocument" style="color:var(--accent);text-decoration:none"><%= currentLang==='zh'?'查看通用 API 文档':'View General API Docs' %> →</a></p>
        </section>

    </div>

    <script>
    // Highlight active nav on scroll
    document.addEventListener('scroll', () => {
        const sections = document.querySelectorAll('section[id]');
        const scrollContainer = document.querySelector('.main');
        const scrollTop = scrollContainer.scrollTop;
        
        sections.forEach(section => {
            const top = section.offsetTop - 100;
            const id = section.getAttribute('id');
            const link = document.querySelector(`.sb a[href="#${id}"]`);
            if (link) {
                if (scrollTop >= top && scrollTop < top + section.offsetHeight) {
                    document.querySelectorAll('.sb a.nl').forEach(a => a.classList.remove('on'));
                    link.classList.add('on');
                }
            }
        });
    }, true);

    // Capture scroll on main container
    document.querySelector('.main').addEventListener('scroll', function() {
        const sections = document.querySelectorAll('section[id]');
        const scrollTop = this.scrollTop;
        
        sections.forEach(section => {
            const top = section.offsetTop - 100;
            const id = section.getAttribute('id');
            const link = document.querySelector(`.sb a[href="#${id}"]`);
            if (link) {
                if (scrollTop >= top && scrollTop < top + section.offsetHeight) {
                    document.querySelectorAll('.sb a.nl').forEach(a => a.classList.remove('on'));
                    link.classList.add('on');
                }
            }
        });
    });
    </script>
