<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="GaurPay BDT API Documentation - Bangladesh Payment Gateway Integration Guide for bKash, Nagad, Rocket, Upay">
    <title>GaurPay BDT API — Bangladesh Payment Documentation</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        :root{--bg:#ffffff;--sidebar:#f8f7f5;--border:#e5e2dc;--text:#111827;--muted:#6b7280;--accent:#0d7c3d;--accent-light:#ecfdf5;--code-bg:#0f172a;--code-text:#e2e8f0;--success:#059669;--warn:#d97706;--radius:8px;--font:'Inter','Noto Sans SC',sans-serif;--mono:'JetBrains Mono',monospace}
        *{margin:0;padding:0;box-sizing:border-box}
        html[lang="zh"] *{font-family:'Inter','Noto Sans SC',"Microsoft YaHei",sans-serif!important}
        body{font-family:var(--font);background:var(--bg);color:var(--text);display:flex;height:100vh;overflow:hidden}

        .sb{width:260px;background:var(--sidebar);border-right:1px solid var(--border);height:100%;overflow-y:auto;flex-shrink:0;padding:1.25rem;display:flex;flex-direction:column}
        .sb-brand{display:flex;align-items:center;gap:.6rem;font-weight:700;font-size:1.15rem;color:var(--accent);margin-bottom:.5rem;text-decoration:none}
        .sb-brand i{font-size:1.3rem}
        .ver{font-size:.6rem;background:var(--accent-light);color:var(--accent);padding:2px 7px;border-radius:10px;font-weight:600;margin-left:auto}
        .lang-row{display:flex;gap:3px;margin:.75rem 0 1.25rem;background:var(--border);padding:3px;border-radius:var(--radius)}
        .lang-row a{flex:1;text-align:center;padding:.35rem;border-radius:6px;font-size:.78rem;font-weight:500;color:var(--muted);text-decoration:none;transition:.2s}
        .lang-row a.on{background:#fff;color:var(--accent);font-weight:600;box-shadow:0 1px 3px rgba(0,0,0,.06)}
        .sb-section{margin-bottom:1.25rem}
        .sb-title{font-size:.6rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:700;margin-bottom:.4rem;padding-left:.6rem}
        .sb a.nl{display:flex;align-items:center;gap:.45rem;padding:.4rem .65rem;color:var(--text);text-decoration:none;font-size:.82rem;border-radius:6px;margin-bottom:1px;font-weight:450;transition:.15s}
        .sb a.nl:hover,.sb a.nl.on{background:var(--accent-light);color:var(--accent)}
        .sb a.nl i{font-size:.85rem;width:16px;text-align:center;opacity:.65}

        .main{flex:1;overflow-y:auto;padding:2.5rem 3.5rem;scroll-behavior:smooth}
        section{margin-bottom:3.5rem;max-width:820px;scroll-margin-top:2rem}
        h1{font-size:1.85rem;margin-bottom:.6rem;font-weight:700}
        h1 small{font-size:.85rem;color:var(--muted);font-weight:400;display:block;margin-top:.2rem}
        h2{font-size:1.3rem;margin-bottom:.85rem;padding-bottom:.4rem;border-bottom:1px solid var(--border);font-weight:650;margin-top:0}
        h3{font-size:1rem;margin:1.25rem 0 .6rem;font-weight:600}
        p{line-height:1.7;color:#374151;margin-bottom:.85rem;font-size:.9rem}

        .ep{display:inline-flex;align-items:center;gap:.5rem;background:#f1f5f9;padding:.45rem .9rem;border-radius:var(--radius);font-family:var(--mono);font-size:.82rem;margin-bottom:1rem;border:1px solid var(--border)}
        .mt{font-weight:700;font-size:.7rem;padding:2px 7px;border-radius:4px;text-transform:uppercase}
        .mt.post{background:#dcfce7;color:#166534}

        table{width:100%;border-collapse:collapse;margin-bottom:1.25rem;font-size:.83rem;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
        th,td{padding:.6rem .85rem;text-align:left;border-bottom:1px solid var(--border)}
        th{background:var(--sidebar);font-weight:600;color:var(--text);font-size:.77rem;text-transform:uppercase;letter-spacing:.03em}
        td{color:#374151}
        td code{font-size:.8em}
        .rq{color:#ef4444;font-size:.67rem;font-weight:600;background:#fef2f2;padding:2px 5px;border-radius:3px;margin-left:3px}
        .op{color:var(--muted);font-size:.67rem;font-weight:500;background:var(--sidebar);padding:2px 5px;border-radius:3px;margin-left:3px}

        code:not(.blk){background:#f1f5f9;padding:.12rem .35rem;border-radius:3px;font-family:var(--mono);font-size:.8em;color:#047857}
        .cb{position:relative;margin-bottom:1.25rem;background:var(--code-bg);border-radius:var(--radius);overflow:hidden}
        .cb pre{margin:0;padding:1rem 1.15rem;overflow-x:auto;font-size:.8rem;line-height:1.6;color:var(--code-text);font-family:var(--mono)}
        .cb .cp{position:absolute;top:6px;right:6px;background:rgba(255,255,255,.1);border:none;color:#94a3b8;padding:4px 9px;border-radius:4px;cursor:pointer;font-size:.7rem;font-family:var(--font);transition:.2s}
        .cb .cp:hover{background:rgba(255,255,255,.2);color:#fff}

        .al{padding:.85rem 1rem;border-radius:var(--radius);border-left:4px solid;margin-bottom:1.25rem;font-size:.85rem;line-height:1.55}
        .al-i{background:var(--accent-light);border-color:var(--accent);color:#065f46}
        .al-w{background:#fef3c7;border-color:var(--warn);color:#92400e}
        .al-s{background:#ecfdf5;border-color:var(--success);color:#065f46}

        .st{display:inline-block;padding:2px 9px;border-radius:16px;font-size:.7rem;font-weight:600;text-transform:uppercase}
        .st.s{background:#dcfce7;color:#166534}
        .st.f{background:#fef2f2;color:#991b1b}
        .st.p{background:#fef3c7;color:#92400e}
        .st.pr{background:#dbeafe;color:#1e40af}

        .wallet-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.75rem;margin-bottom:1.25rem}
        .wallet-card{background:var(--sidebar);border:1px solid var(--border);border-radius:var(--radius);padding:.85rem;text-align:center;transition:.2s}
        .wallet-card:hover{border-color:var(--accent);box-shadow:0 2px 8px rgba(0,0,0,.06)}
        .wallet-card .wn{font-weight:600;font-size:.9rem;margin-bottom:.25rem}
        .wallet-card .wc{font-family:var(--mono);font-size:.75rem;color:var(--accent);background:var(--accent-light);padding:2px 8px;border-radius:4px;display:inline-block}

        .mob-btn{display:none;position:fixed;top:.8rem;left:.8rem;z-index:200;background:var(--accent);color:#fff;border:none;width:36px;height:36px;border-radius:var(--radius);cursor:pointer;font-size:1.1rem;align-items:center;justify-content:center}
        @media(max-width:1024px){
            .sb{position:fixed;z-index:150;transform:translateX(-100%);transition:.3s}.sb.show{transform:translateX(0)}
            .mob-btn{display:flex}.main{padding:2rem 1.25rem;padding-top:3rem}
        }
    </style>
</head>
<body>
    <button class="mob-btn" onclick="document.querySelector('.sb').classList.toggle('show')"><i class="ri-menu-line"></i></button>

    <aside class="sb">
        <a href="/" class="sb-brand"><i class="ri-shield-keyhole-fill"></i> GaurPay <span class="ver">BDT</span></a>
        <div class="lang-row">
            <a href="?lang=en" class="<%= currentLang==='en'?'on':'' %>">English</a>
            <a href="?lang=zh" class="<%= currentLang==='zh'?'on':'' %>">中文</a>
        </div>

        <div class="sb-section">
            <div class="sb-title"><%= currentLang==='zh'?'概览':'OVERVIEW' %></div>
            <a href="#overview" class="nl"><i class="ri-book-read-line"></i> <%= currentLang==='zh'?'快速入门':'Quick Start' %></a>
            <a href="#auth" class="nl"><i class="ri-key-2-line"></i> <%= currentLang==='zh'?'鉴权':'Authentication' %></a>
            <a href="#channels" class="nl"><i class="ri-smartphone-line"></i> <%= currentLang==='zh'?'钱包通道':'Wallet Channels' %></a>
        </div>

        <div class="sb-section">
            <div class="sb-title"><%= currentLang==='zh'?'代收 (PayIn)':'PAYIN (COLLECT)' %></div>
            <a href="#payin-create" class="nl"><i class="ri-add-circle-line"></i> <%= currentLang==='zh'?'创建代收':'Create PayIn' %></a>
            <a href="#payin-query" class="nl"><i class="ri-search-line"></i> <%= currentLang==='zh'?'查询代收':'Query PayIn' %></a>
            <a href="#payin-callback" class="nl"><i class="ri-notification-line"></i> <%= currentLang==='zh'?'代收回调':'PayIn Callback' %></a>
        </div>

        <div class="sb-section">
            <div class="sb-title"><%= currentLang==='zh'?'代付 (PayOut)':'PAYOUT (TRANSFER)' %></div>
            <a href="#payout-create" class="nl"><i class="ri-send-plane-line"></i> <%= currentLang==='zh'?'创建代付':'Create PayOut' %></a>
            <a href="#payout-query" class="nl"><i class="ri-search-line"></i> <%= currentLang==='zh'?'查询代付':'Query PayOut' %></a>
            <a href="#payout-callback" class="nl"><i class="ri-notification-line"></i> <%= currentLang==='zh'?'代付回调':'PayOut Callback' %></a>
        </div>

        <div class="sb-section">
            <div class="sb-title"><%= currentLang==='zh'?'账户':'ACCOUNT' %></div>
            <a href="#balance" class="nl"><i class="ri-wallet-3-line"></i> <%= currentLang==='zh'?'余额查询':'Balance Query' %></a>
        </div>

        <div class="sb-section" style="margin-top:auto">
            <a href="/apidocument" class="nl"><i class="ri-arrow-left-line"></i> <%= currentLang==='zh'?'返回通用文档':'Back to General Docs' %></a>
        </div>
    </aside>

    <div class="main">

        <!-- OVERVIEW -->
        <section id="overview">
            <h1>🇧🇩 <%= currentLang==='zh'?'孟加拉国 BDT 支付 API':'Bangladesh BDT Payment API' %>
                <small><%= currentLang==='zh'?'支持 bKash, Nagad, Rocket, Upay 钱包通道的代收代付接口':'PayIn & PayOut API supporting bKash, Nagad, Rocket, Upay wallet channels' %></small>
            </h1>

            <div class="al al-i">
                <strong><%= currentLang==='zh'?'基础信息':'Base Info' %></strong><br>
                <%= currentLang==='zh'?'基础URL':'Base URL' %>: <code>https://gaurpay.site</code><br>
                <%= currentLang==='zh'?'货币':'Currency' %>: <code>BDT</code> (৳)<br>
                <%= currentLang==='zh'?'签名方式':'Signature' %>: HMAC-SHA256
            </div>

            <p><%= currentLang==='zh'
                ?'本文档详细说明了 GaurPay 孟加拉国 BDT 支付通道的 API 接口，支持 bKash、Nagad、Rocket、Upay 四大钱包服务商。所有字段与 BCAT 类 API 完全兼容，方便快速接入。'
                :'This document details the GaurPay Bangladesh BDT payment channel API, supporting bKash, Nagad, Rocket, and Upay wallet providers. All fields are fully compatible with BCAT-style APIs for easy integration.' %></p>
        </section>

        <!-- AUTH -->
        <section id="auth">
            <h2><i class="ri-key-2-line" style="margin-right:.35rem"></i> <%= currentLang==='zh'?'鉴权':'Authentication' %></h2>
            <p><%= currentLang==='zh'
                ?'所有 API 请求需要以下鉴权参数：'
                :'All API requests require the following authentication parameters:' %></p>

            <table>
                <tr><th><%= currentLang==='zh'?'参数':'Parameter' %></th><th><%= currentLang==='zh'?'类型':'Type' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr>
                <tr><td><code>userId</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'商户 API Key (在商户后台获取)':'Merchant API Key (from merchant dashboard)' %></td></tr>
                <tr><td><code>sign</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'HMAC-SHA256 签名':'HMAC-SHA256 Signature' %></td></tr>
            </table>

            <h3><%= currentLang==='zh'?'签名生成':'Signature Generation' %></h3>
            <div class="cb"><button class="cp" onclick="navigator.clipboard.writeText(this.nextElementSibling.textContent)">Copy</button><pre>// 1. Sort all params alphabetically (exclude 'sign')
// 2. Concatenate as key=value&key=value&...
// 3. HMAC-SHA256 with your API Secret
// 4. Convert to lowercase hex

const params = { userId, orderId, orderAmount, callbackUrl, currency: 'BDT' };
const sorted = Object.keys(params).sort().map(k => `${k}=${params[k]}`).join('&');
const sign = crypto.createHmac('sha256', apiSecret).update(sorted).digest('hex');</pre></div>
        </section>

        <!-- WALLET CHANNELS -->
        <section id="channels">
            <h2><i class="ri-smartphone-line" style="margin-right:.35rem"></i> <%= currentLang==='zh'?'钱包通道 (channelCode)':'Wallet Channels (channelCode)' %></h2>
            <p><%= currentLang==='zh'
                ?'通过 channelCode 参数指定钱包服务商，支持以下四种：'
                :'Use the channelCode parameter to specify the wallet provider. Supported values:' %></p>

            <div class="wallet-grid">
                <div class="wallet-card">
                    <div class="wn">bKash</div>
                    <div class="wc">bkash</div>
                </div>
                <div class="wallet-card">
                    <div class="wn">Nagad</div>
                    <div class="wc">nagad</div>
                </div>
                <div class="wallet-card">
                    <div class="wn">Rocket</div>
                    <div class="wc">rocket</div>
                </div>
                <div class="wallet-card">
                    <div class="wn">Upay</div>
                    <div class="wc">upay</div>
                </div>
            </div>

            <div class="al al-w">
                <strong><%= currentLang==='zh'?'注意':'Important' %>:</strong>
                <%= currentLang==='zh'
                    ?'channelCode 值必须小写。代付时 channelCode 为必填项。代收时为可选项，不填则使用默认通道。'
                    :'channelCode values must be lowercase. For PayOut, channelCode is required. For PayIn, it is optional and defaults to the configured channel.' %>
            </div>

            <table>
                <tr><th>channelCode</th><th><%= currentLang==='zh'?'代收通道ID':'PayIn tdid' %></th><th><%= currentLang==='zh'?'代付通道ID':'PayOut tdid' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr>
                <tr><td><code>bkash</code></td><td>3883</td><td>3884</td><td><%= currentLang==='zh'?'bKash 手机钱包':'bKash Mobile Wallet' %></td></tr>
                <tr><td><code>nagad</code></td><td>3885</td><td>3886</td><td><%= currentLang==='zh'?'Nagad 手机钱包':'Nagad Mobile Wallet' %></td></tr>
                <tr><td><code>rocket</code></td><td><%= currentLang==='zh'?'默认':'default' %></td><td><%= currentLang==='zh'?'默认':'default' %></td><td><%= currentLang==='zh'?'Rocket 手机钱包':'Rocket Mobile Wallet' %></td></tr>
                <tr><td><code>upay</code></td><td><%= currentLang==='zh'?'默认':'default' %></td><td><%= currentLang==='zh'?'默认':'default' %></td><td><%= currentLang==='zh'?'Upay 手机钱包':'Upay Mobile Wallet' %></td></tr>
            </table>
        </section>

        <!-- PAYIN CREATE -->
        <section id="payin-create">
            <h2><i class="ri-add-circle-line" style="margin-right:.35rem"></i> <%= currentLang==='zh'?'创建代收订单':'Create PayIn Order' %></h2>
            <div class="ep"><span class="mt post">POST</span> /api/payin/create</div>

            <h3><%= currentLang==='zh'?'请求参数':'Request Parameters' %></h3>
            <table>
                <tr><th><%= currentLang==='zh'?'参数':'Parameter' %></th><th><%= currentLang==='zh'?'类型':'Type' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr>
                <tr><td><code>userId</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'商户 API Key':'Merchant API Key' %></td></tr>
                <tr><td><code>sign</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'签名':'Signature' %></td></tr>
                <tr><td><code>orderId</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'商户订单号':'Merchant Order ID' %></td></tr>
                <tr><td><code>orderAmount</code> <span class="rq">Required</span></td><td>Number</td><td><%= currentLang==='zh'?'订单金额 (BDT, 最低 ৳100)':'Order amount (BDT, min ৳100)' %></td></tr>
                <tr><td><code>callbackUrl</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'支付结果回调URL':'Payment result callback URL' %></td></tr>
                <tr><td><code>currency</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'固定值':'Fixed value' %>: <code>BDT</code></td></tr>
                <tr><td><code>channelCode</code> <span class="op">Optional</span></td><td>String</td><td><%= currentLang==='zh'?'钱包通道: bkash / nagad / rocket / upay':'Wallet channel: bkash / nagad / rocket / upay' %></td></tr>
                <tr><td><code>skipUrl</code> <span class="op">Optional</span></td><td>String</td><td><%= currentLang==='zh'?'支付完成跳转URL':'Redirect URL after payment' %></td></tr>
                <tr><td><code>customerName</code> <span class="op">Optional</span></td><td>String</td><td><%= currentLang==='zh'?'客户姓名':'Customer name' %></td></tr>
                <tr><td><code>customerPhone</code> <span class="op">Optional</span></td><td>String</td><td><%= currentLang==='zh'?'客户手机号':'Customer phone' %></td></tr>
            </table>

            <h3><%= currentLang==='zh'?'成功响应':'Success Response' %></h3>
            <div class="cb"><button class="cp" onclick="navigator.clipboard.writeText(this.nextElementSibling.textContent)">Copy</button><pre>{
  "status": "success",
  "message": "Order created successfully",
  "timestamp": "2026-07-15T05:00:00.000Z",
  "result": {
    "merchantOrderId": "BD_ORDER_001",
    "platformOrderId": "uuid-xxxx",
    "currency": "BDT",
    "requestedAmount": 500,
    "processingFee": 25.00,
    "paymentUrl": "https://gaurpay.site/pay/uuid-xxxx",
    "channelCode": "bkash",
    "account_number": "01XXXXXXXXX",
    "account_name": "Payment Account",
    "qrcode": "qr_data_string",
    "bankName": "bKash",
    "bankCode": "bkash",
    "expiresIn": 1800
  }
}</pre></div>

            <h3><%= currentLang==='zh'?'V2 格式 (推荐)':'V2 Format (Recommended)' %></h3>
            <div class="ep"><span class="mt post">POST</span> /v2/collection/initiate</div>
            <table>
                <tr><th><%= currentLang==='zh'?'V2 参数':'V2 Parameter' %></th><th><%= currentLang==='zh'?'对应 V1':'Maps to V1' %></th></tr>
                <tr><td><code>merchant_order_id</code></td><td><code>orderId</code></td></tr>
                <tr><td><code>amount</code></td><td><code>orderAmount</code></td></tr>
                <tr><td><code>notify_url</code></td><td><code>callbackUrl</code></td></tr>
                <tr><td><code>channel_code</code></td><td><code>channelCode</code></td></tr>
            </table>

            <h3><%= currentLang==='zh'?'V3 格式':'V3 Format' %></h3>
            <div class="ep"><span class="mt post">POST</span> /v3/deposit/create</div>
            <table>
                <tr><th><%= currentLang==='zh'?'V3 参数':'V3 Parameter' %></th><th><%= currentLang==='zh'?'对应 V1':'Maps to V1' %></th></tr>
                <tr><td><code>ref_id</code></td><td><code>orderId</code></td></tr>
                <tr><td><code>txn_amount</code></td><td><code>orderAmount</code></td></tr>
                <tr><td><code>webhook_url</code></td><td><code>callbackUrl</code></td></tr>
                <tr><td><code>channel_code</code></td><td><code>channelCode</code></td></tr>
            </table>
        </section>

        <!-- PAYIN QUERY -->
        <section id="payin-query">
            <h2><i class="ri-search-line" style="margin-right:.35rem"></i> <%= currentLang==='zh'?'查询代收订单':'Query PayIn Order' %></h2>
            <div class="ep"><span class="mt post">POST</span> /api/payin/query</div>

            <table>
                <tr><th><%= currentLang==='zh'?'参数':'Parameter' %></th><th><%= currentLang==='zh'?'类型':'Type' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr>
                <tr><td><code>userId</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'商户 API Key':'Merchant API Key' %></td></tr>
                <tr><td><code>sign</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'签名':'Signature' %></td></tr>
                <tr><td><code>orderId</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'商户订单号':'Merchant Order ID' %></td></tr>
            </table>

            <h3><%= currentLang==='zh'?'响应':'Response' %></h3>
            <div class="cb"><button class="cp" onclick="navigator.clipboard.writeText(this.nextElementSibling.textContent)">Copy</button><pre>{
  "status": "success",
  "result": {
    "merchantOrderId": "BD_ORDER_001",
    "platformOrderId": "uuid-xxxx",
    "orderStatus": "success",
    "requestedAmount": 500,
    "settledAmount": 475.00,
    "processingFee": 25.00,
    "transactionRef": "TXN12345678",
    "createdAt": "2026-07-15T05:00:00.000Z"
  }
}</pre></div>

            <h3><%= currentLang==='zh'?'订单状态':'Order Status' %></h3>
            <table>
                <tr><th><%= currentLang==='zh'?'状态':'Status' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr>
                <tr><td><span class="st p">pending</span></td><td><%= currentLang==='zh'?'等待付款':'Waiting for payment' %></td></tr>
                <tr><td><span class="st s">success</span></td><td><%= currentLang==='zh'?'支付成功':'Payment successful' %></td></tr>
                <tr><td><span class="st f">failed</span></td><td><%= currentLang==='zh'?'支付失败':'Payment failed' %></td></tr>
                <tr><td><span class="st f">expired</span></td><td><%= currentLang==='zh'?'订单过期':'Order expired' %></td></tr>
            </table>
        </section>

        <!-- PAYIN CALLBACK -->
