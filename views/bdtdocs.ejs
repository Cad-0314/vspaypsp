}</pre></div>

            <h3><%= currentLang==='zh'?'代付状态':'PayOut Status' %></h3>
            <table>
                <tr><th><%= currentLang==='zh'?'状态':'Status' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr>
                <tr><td><span class="st pr">processing</span></td><td><%= currentLang==='zh'?'处理中':'In progress' %></td></tr>
