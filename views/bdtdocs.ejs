                ?'支付成功或失败后，系统将向您的 callbackUrl 发送 POST 请求。'
                :'After payment success or failure, the system will send a POST request to your callbackUrl.' %></p>

            <table>
                <tr><th><%= currentLang==='zh'?'参数':'Parameter' %></th><th><%= currentLang==='zh'?'类型':'Type' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr>
                <tr><td><code>orderId</code></td><td>String</td><td><%= currentLang==='zh'?'商户订单号':'Merchant Order ID' %></td></tr>
                <tr><td><code>platformOrderId</code></td><td>String</td><td><%= currentLang==='zh'?'平台订单号':'Platform Order ID' %></td></tr>
                <tr><td><code>orderStatus</code></td><td>String</td><td><%= currentLang==='zh'?'订单状态: success / failed':'Order status: success / failed' %></td></tr>
                <tr><td><code>amount</code></td><td>Number</td><td><%= currentLang==='zh'?'订单金额':'Order amount' %></td></tr>
                <tr><td><code>netAmount</code></td><td>Number</td><td><%= currentLang==='zh'?'结算金额 (扣除手续费)':'Settled amount (after fee)' %></td></tr>
                <tr><td><code>transactionRef</code></td><td>String</td><td><%= currentLang==='zh'?'交易参考号 (UTR)':'Transaction reference (UTR)' %></td></tr>
                <tr><td><code>sign</code></td><td>String</td><td><%= currentLang==='zh'?'签名，请验证':'Signature, please verify' %></td></tr>
            </table>

            <div class="al al-i">
                <strong><%= currentLang==='zh'?'重要':'Important' %>:</strong>
                <%= currentLang==='zh'
                    ?'收到回调后必须返回字符串 "success"，否则系统会重试发送。'
                    :'You must return the string "success" after receiving the callback, otherwise the system will retry.' %>
            </div>
        </section>

        <!-- PAYOUT CREATE -->
        <section id="payout-create">
            <h2><i class="ri-send-plane-line" style="margin-right:.35rem"></i> <%= currentLang==='zh'?'创建代付订单':'Create PayOut Order' %></h2>
            <div class="ep"><span class="mt post">POST</span> /api/payout/bank</div>

            <table>
                <tr><th><%= currentLang==='zh'?'参数':'Parameter' %></th><th><%= currentLang==='zh'?'类型':'Type' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr>
                <tr><td><code>userId</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'商户 API Key':'Merchant API Key' %></td></tr>
                <tr><td><code>sign</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'签名':'Signature' %></td></tr>
                <tr><td><code>orderId</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'商户订单号':'Merchant Order ID' %></td></tr>
                <tr><td><code>amount</code> <span class="rq">Required</span></td><td>Number</td><td><%= currentLang==='zh'?'代付金额 (BDT, 整数, 最低 ৳100)':'Payout amount (BDT, integer, min ৳100)' %></td></tr>
                <tr><td><code>account</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'收款钱包号码 (手机号)':'Receiving wallet number (phone number)' %></td></tr>
                <tr><td><code>personName</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'收款人姓名':'Recipient name' %></td></tr>
                <tr><td><code>currency</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'固定值':'Fixed value' %>: <code>BDT</code></td></tr>
                <tr><td><code>channelCode</code> <span class="rq">Required</span></td><td>String</td><td><%= currentLang==='zh'?'钱包通道 (必填): bkash / nagad / rocket / upay':'Wallet channel (required): bkash / nagad / rocket / upay' %></td></tr>
                <tr><td><code>callbackUrl</code> <span class="op">Optional</span></td><td>String</td><td><%= currentLang==='zh'?'代付结果回调URL':'Payout result callback URL' %></td></tr>
            </table>

            <div class="al al-w">
                <strong><%= currentLang==='zh'?'重要':'Important' %>:</strong>
                <%= currentLang==='zh'
                    ?'channelCode 为必填项，值必须小写，错误的值将导致代付失败！也可使用 bankCode 字段代替。'
                    :'channelCode is required and must be lowercase. Incorrect values will cause payout failure! You can also use the bankCode field as an alternative.' %>
            </div>

            <h3><%= currentLang==='zh'?'成功响应':'Success Response' %></h3>
            <div class="cb"><button class="cp" onclick="navigator.clipboard.writeText(this.nextElementSibling.textContent)">Copy</button><pre>{
  "status": "success",
  "message": "Payout submitted successfully",
  "timestamp": "2026-07-15T05:00:00.000Z",
  "result": {
    "merchantOrderId": "BD_PAY_001",
    "platformOrderId": "uuid-xxxx",
    "payoutAmount": 1000,
    "processingFee": 10.00,
    "orderStatus": "processing",
    "channelCode": "bkash"
  }
}</pre></div>

            <h3><%= currentLang==='zh'?'V2 格式':'V2 Format' %></h3>
            <div class="ep"><span class="mt post">POST</span> /v2/transfer/bank</div>
            <table>
                <tr><th><%= currentLang==='zh'?'V2 参数':'V2 Parameter' %></th><th><%= currentLang==='zh'?'对应 V1':'Maps to V1' %></th></tr>
                <tr><td><code>merchant_order_id</code></td><td><code>orderId</code></td></tr>
                <tr><td><code>amount</code></td><td><code>amount</code></td></tr>
                <tr><td><code>account_number</code></td><td><code>account</code></td></tr>
                <tr><td><code>beneficiary_name</code></td><td><code>personName</code></td></tr>
                <tr><td><code>channel_code</code></td><td><code>channelCode</code></td></tr>
            </table>

            <h3><%= currentLang==='zh'?'V3 格式':'V3 Format' %></h3>
            <div class="ep"><span class="mt post">POST</span> /v3/withdraw/bank</div>
            <table>
                <tr><th><%= currentLang==='zh'?'V3 参数':'V3 Parameter' %></th><th><%= currentLang==='zh'?'对应 V1':'Maps to V1' %></th></tr>
                <tr><td><code>ref_id</code></td><td><code>orderId</code></td></tr>
                <tr><td><code>txn_amount</code></td><td><code>amount</code></td></tr>
                <tr><td><code>bank_account</code></td><td><code>account</code></td></tr>
                <tr><td><code>payee_name</code></td><td><code>personName</code></td></tr>
                <tr><td><code>channel_code</code></td><td><code>channelCode</code></td></tr>
            </table>
        </section>

        <!-- PAYOUT QUERY -->
        <section id="payout-query">
            <h2><i class="ri-search-line" style="margin-right:.35rem"></i> <%= currentLang==='zh'?'查询代付订单':'Query PayOut Order' %></h2>
