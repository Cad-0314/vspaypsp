                    <option value="gaurpay">GaurPay</option>
                    <option value="yellow">Yellow</option>
                    <option value="upi super">UPI Super</option>
                    <option value="ckpay">CKPay</option>
                    <option value="bharatpay">BharatPay</option>
                    <option value="cxpay">CX Pay</option>
                    <option value="ipay">IPay</option>
                    <option value="smart">Smart (智能支付)</option>
                </select>

                <label style="display:block; margin-bottom:0.25rem; font-size:0.875rem; color:#6B7280;">
                    <%= t('payout_channel') %>
                </label>
                <select id="m-payout-channel"
                    style="width:100%; margin-bottom:0.75rem; padding:0.75rem; border:1px solid #E5E7EB; border-radius:0.5rem;">
                    <option value="">
                        <%= t('select_channel') %>
                    </option>
                    <option value="aapay">AA Pay</option>
                    <option value="gaurpay">GaurPay</option>
                    <option value="yellow">Yellow</option>
                    <option value="upi super">UPI Super</option>
                    <option value="ckpay">CKPay</option>
                    <option value="bharatpay">BharatPay</option>
                    <option value="cxpay">CX Pay</option>
                    <option value="ipay">IPay</option>
                </select>
                <input type="text" id="m-telegramGroup" placeholder="<%= t('telegram_group_placeholder') %>"
                    style="width:100%; margin-bottom:0.75rem; padding:0.75rem; border:1px solid #E5E7EB; border-radius:0.5rem;">
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem;">
                    <input type="number" id="m-payin" placeholder="<%= t('payin_percentage_placeholder') %>" value="5"
                        style="padding:0.75rem; border:1px solid #E5E7EB; border-radius:0.5rem;">
                    <input type="number" id="m-payout" placeholder="<%= t('payout_percentage_placeholder') %>" value="3"
                        style="padding:0.75rem; border:1px solid #E5E7EB; border-radius:0.5rem;">
                    <input type="number" id="m-fixed" placeholder="<%= t('fixed_fee_placeholder') %>" value="6"
                        style="padding:0.75rem; border:1px solid #E5E7EB; border-radius:0.5rem;">
                    <input type="number" id="m-usdt" placeholder="<%= t('usdt_percentage_placeholder') %>" value="0"
                        style="padding:0.75rem; border:1px solid #E5E7EB; border-radius:0.5rem;">
                </div>

                <!-- Suspension & Status -->
                <div style="margin-top:1rem; display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem;">
                    <label style="display:flex; align-items:center; gap:0.5rem; font-size:0.875rem;">
                        <input type="checkbox" id="m-isActive" checked>
                        <%= t('account_active') %>
                    </label>
                    <label style="display:flex; align-items:center; gap:0.5rem; font-size:0.875rem;">
                        <input type="checkbox" id="m-canPayin" checked>
                        <%= t('allow_payin') %>
                    </label>
                    <label style="display:flex; align-items:center; gap:0.5rem; font-size:0.875rem;">
                        <input type="checkbox" id="m-canPayout" checked>
                        <%= t('allow_payout') %>
                    </label>
                </div>

                <!-- TOTP for Delete -->
                <div id="m-totp-container"
                    style="margin-top:1.5rem; padding-top:1rem; border-top: 1px solid #F3F4F6; display:none;">
                    <label
                        style="display:block; margin-bottom:0.5rem; font-weight:600; font-size:0.875rem; color:var(--danger);">2FA
                        TOTP Code (Required for Delete)</label>
                    <input type="text" id="m-totp" placeholder="Enter 6-digit code"
                        style="width: 100%; padding: 0.75rem; border: 2px solid #FEE2E2; border-radius:0.5rem; text-align:center; font-weight:bold; letter-spacing:4px;">
                </div>

                <div style="margin-top: 1.5rem; display:flex; gap: 1rem; flex-wrap:wrap;">
                    <button type="button" class="btn btn-primary" onclick="saveMerchant()"
                        style="flex:1; min-width:120px; justify-content:center;">
                        <%= t('save') %>
                    </button>
                    <button type="button" id="btn-delete-merchant" class="btn btn-danger"
                        onclick="deleteMerchantAction()"
                        style="flex:1; min-width:120px; justify-content:center; display:none;">
                        <%= t('delete') %>
                    </button>
                    <button type="button" class="btn"
                        onclick="document.getElementById('merchantModal').style.display='none'"
                        style="flex:1; min-width:120px; justify-content:center; background:#F3F4F6;">
                        <%= t('cancel') %>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Balance Adjustment Modal -->
    <div id="balanceAdjModal"
        style="display:none; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); backdrop-filter:blur(4px); align-items:center; justify-content:center; z-index:100;">
        <div
            style="background:white; padding:2rem; width:450px; border-radius:1rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
            <h3 style="margin-bottom:1.5rem;">
                <%= t('balance_adjustment') %>
            </h3>
            <p id="adj-merchant-info" style="font-size:0.875rem; color:#6B7280; margin-bottom:1rem;"></p>
            <input type="hidden" id="adj-m-id">

            <div style="margin-bottom: 1rem;">
                <label style="display:block; margin-bottom:0.5rem; font-size:0.875rem;">
                    <%= t('adjustment_type') %>
                </label>
                <select id="adj-type"
                    style="width:100%; padding:0.75rem; border:1px solid #E5E7EB; border-radius:0.5rem;">
                    <option value="increase">
                        <%= t('increase') %>
                    </option>
                    <option value="decrease">
                        <%= t('decrease') %>
                    </option>
                </select>
            </div>

            <div style="margin-bottom: 1rem;">
                <label style="display:block; margin-bottom:0.5rem; font-size:0.875rem;">
                    <%= t('adjustment_amount') %>
                </label>
                <input type="number" id="adj-amount" placeholder="0.00"
                    style="width:100%; padding:0.75rem; border:1px solid #E5E7EB; border-radius:0.5rem;">
            </div>

            <div style="margin-bottom: 1rem;">
                <label style="display:block; margin-bottom:0.5rem; font-size:0.875rem;">
                    <%= t('reason') %>
                </label>
                <textarea id="adj-note"
                    style="width:100%; padding:0.75rem; border:1px solid #E5E7EB; border-radius:0.5rem;"
                    placeholder="Internal note..."></textarea>
            </div>

            <div style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #F3F4F6;">
                <label
                    style="display:block; margin-bottom:0.5rem; font-weight:600; font-size:0.875rem; color:var(--danger);">2FA
                    TOTP Code</label>
                <input type="text" id="adj-totp" placeholder="Enter 6-digit code"
                    style="width: 100%; padding: 0.75rem; border: 2px solid #FEE2E2; border-radius:0.5rem; text-align:center; font-weight:bold; letter-spacing:4px;">
            </div>

            <div style="margin-top: 1.5rem; display:flex; gap: 1rem;">
                <button class="btn btn-primary" onclick="saveBalanceAdjustment()"
                    style="flex:1; justify-content:center;">
                    <%= t('save') %>
                </button>
                <button class="btn" onclick="document.getElementById('balanceAdjModal').style.display='none'"
                    style="flex:1; justify-content:center; background:#F3F4F6;">
                    <%= t('cancel') %>
                </button>
            </div>
        </div>
    </div>

    <script id="translations-data" type="application/json"><%- JSON.stringify(allTranslations) %></script>
    <script>

        // Inject translations
        window.allTranslations = JSON.parse(document.getElementById('translations-data').textContent);

        // Client-side translation helper
        function _t(key, params = {}) {
            const lang = document.cookie.split('; ').find(row => row.startsWith('lang='))?.split('=')[1] || 'zh';
            let text = (window.allTranslations[lang] && window.allTranslations[lang][key]) || key;
            Object.keys(params).forEach(k => {
                text = text.replace(new RegExp(`{${k}}`, 'g'), params[k]);
            });
            return text;
        }

        let merchantSearchTimeout = null;

        function showToast(message, type = 'success') {
            Toastify({
                text: message,
                duration: 3000,
                close: true,
                gravity: "top",
                position: "right",
                backgroundColor: type === 'error' ? "#EF4444" : "#10B981",
                stopOnFocus: true
            }).showToast();
        }

        function renderPagination(paging, containerId, clickActionTemplate) {
            const container = document.getElementById(containerId);
            // Safety check: if container doesn't exist, log warning but don't crash
            if (!container) {
                console.warn(`Pagination container not found: ${containerId}`);
                return;
            }
            if (!paging || paging.pages <= 1) { container.innerHTML = ''; return; }


            const prevAction = clickActionTemplate.replace('{page}', paging.page - 1);
            const nextAction = clickActionTemplate.replace('{page}', paging.page + 1);

            container.innerHTML = `
                <span style="font-size:0.875rem; color:grey; margin-right:auto;">${_t('page_info', { page: paging.page, pages: paging.pages, total: paging.total })}</span>
                <button class="btn" style="padding:0.25rem 0.75rem; background:${paging.page > 1 ? 'white' : '#F3F4F6'}; border:1px solid #E5E7EB;" 
                    onclick="${prevAction}" ${paging.page <= 1 ? 'disabled' : ''}><i class="ri-arrow-left-s-line"></i></button>
                <button class="btn" style="padding:0.25rem 0.75rem; background:${paging.page < paging.pages ? 'white' : '#F3F4F6'}; border:1px solid #E5E7EB;" 
                    onclick="${nextAction}" ${paging.page >= paging.pages ? 'disabled' : ''}><i class="ri-arrow-right-s-line"></i></button>
            `;
        }
        // ... Logic remains identical, just UI structure ...
        async function openBoostModal() {
            try {
                const res = await fetch('/admin/api/boost-settings');
                const data = await res.json();
                if (data.success) {
                    document.getElementById('boost-enabled').checked = data.config.enabled;
                    document.getElementById('boost-count').value = data.config.payinCountBoost;
                    document.getElementById('boost-volume').value = data.config.payinVolumeBoost;
                    document.getElementById('boostModal').style.display = 'flex';
                }
            } catch (e) {
                showToast('Failed to load settings', 'error');
            }
        }

        async function saveBoostSettings() {
            try {
                const enabled = document.getElementById('boost-enabled').checked;
                const payinCountBoost = document.getElementById('boost-count').value;
                const payinVolumeBoost = document.getElementById('boost-volume').value;

                const res = await fetch('/admin/api/boost-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled, payinCountBoost, payinVolumeBoost })
                });

                const data = await res.json();
                if (data.success) {
                    showToast('Optimization settings saved');
                    document.getElementById('boostModal').style.display = 'none';
                    loadStats(); // Refresh stats immediately
                } else {
                    showToast(data.error || 'Failed to save', 'error');
                }
            } catch (e) {
                showToast('Error saving settings', 'error');
            }
        }

        switchTab('dashboard');
        loadStats();

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.querySelector('.overlay').classList.toggle('active');
        }

        function switchTab(tab) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.getElementById('tab-' + tab).classList.add('active');
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            if (window.innerWidth <= 1024) toggleSidebar();
            event && event.currentTarget.classList.add('active');

            if (tab === 'orders') loadGlobalOrders();
            if (tab === 'settlements') loadSettlements();
            if (tab === 'merchants') loadMerchants();
            if (tab === 'channels') loadChannels();
            if (tab === 'smartchannel') loadSmartRanges();
            if (tab === 'manualpayout') loadManualPayouts();
        }

        async function loadStats() {
            try {
                const res = await fetch('/admin/api/stats');
                const data = await res.json();
                if (data.success) {
                    const s = data.stats;
                    document.getElementById('stat-profit').innerText = s.adminBalance.toFixed(2);
                    document.getElementById('stat-merchant-balance').innerText = s.totalMerchantBalance.toFixed(2);
                    document.getElementById('stat-today-payin').innerText = s.today.payin.toFixed(2);
                    document.getElementById('stat-merchants').innerText = s.merchantCount;
                }

                const ctx = document.getElementById('adminChart').getContext('2d');
                const cRes = await fetch('/admin/api/chart');
                const cData = await cRes.json();
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: cData.labels,
                        datasets: [
                            { label: 'Payin Volume', data: cData.payinData, backgroundColor: '#6366f1', borderRadius: 4 },
                            { label: 'Payout Volume', data: cData.payoutData, backgroundColor: '#ef4444', borderRadius: 4 }
                        ]
                    },
                    options: { responsive: true, maintainAspectRatio: false, scales: { x: { grid: { display: false } } } }
                });
            } catch (e) { console.error(e); }
        }

        async function loadGlobalOrders(page = 1) {
            const search = document.getElementById('order-search').value;
            const startDate = document.getElementById('order-filter-start').value;
            const endDate = document.getElementById('order-filter-end').value;
            const status = document.getElementById('order-filter-status').value;

            let url = `/admin/api/orders?limit=20&page=${page}`;
            if (search) url += `&search=${search}`;
            if (status) url += `&status=${status}`;
            if (startDate) url += `&startDate=${startDate}`;
            if (endDate) url += `&endDate=${endDate}`;

            const res = await fetch(url);
            const data = await res.json();
            const tbody = document.getElementById('global-orders-table').querySelector('tbody');

            if (data.success && data.orders.length > 0) {
                tbody.innerHTML = data.orders.map(o => `
                    <tr>
                        <td title="${o.id}"><small style="font-family:monospace;">${o.orderId}</small></td>
                        <td>${o.merchant?.username || 'N/A'}</td>
                        <td>₹${o.amount}</td>
                        <td><span class="badge badge-${o.status}">${o.status}</span></td>
                        <td>${new Date(o.createdAt).toLocaleString()}</td>
                        <td>${new Date(o.updatedAt).toLocaleString()}</td>
                    </tr>
                `).join('');
                renderPagination(data.pagination, 'orders-pagination', `loadGlobalOrders({page})`);
            } else {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #9ca3af; padding:2rem;">${_t('no_orders_found')}</td></tr>`;
                document.getElementById('orders-pagination').innerHTML = '';
            }
        }

        async function loadSettlements(page = 1) {
            const status = document.getElementById('settle-filter-status').value;
            const type = document.getElementById('settle-filter-type').value;
            const search = document.getElementById('settle-search').value;

            let url = `/admin/api/settlements?page=${page}`;
            if (status) url += `&status=${status}`;
            if (type) url += `&type=${type}`;
            if (search) url += `&search=${search}`;

            const res = await fetch(url);
            const data = await res.json();
            const tbody = document.getElementById('settlements-table').querySelector('tbody');

            if (data.success && data.settlements.length > 0) {
                tbody.innerHTML = data.settlements.map(s => `
                    <tr>
                        <td style="font-family:monospace;">${s.id}</td>
                        <td>${s.merchant?.username || 'N/A'}</td>
                        <td><span class="badge" style="background:#E0E7FF; color:#4338CA;">${s.type.toUpperCase()}</span></td>
                        <td>₹${s.amount}</td>
                        <td><span class="badge badge-${s.status}">${s.status}</span></td>
                        <td>${new Date(s.createdAt).toLocaleString()}</td>
                        <td>${new Date(s.updatedAt).toLocaleString()}</td>
                        <td>
                            ${s.status === 'pending' ?
                        `<button class="btn btn-primary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem;" onclick="openSettleAction('${s.id}')">Process</button>` :
                        `<small style="color:grey;">Processed</small>`}
                        </td>
                    </tr>
                `).join('');
                renderPagination(data.pagination, 'settlements-pagination', `loadSettlements({page})`);
            } else {
                tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; color: #9ca3af; padding:2rem;">${_t('no_settlements_found')}</td></tr>`;
                document.getElementById('settlements-pagination').innerHTML = '';
            }
        }

        function openSettleAction(id) {
            document.getElementById('settle-id').value = id;
            document.getElementById('settle-totp').value = '';
            document.getElementById('settleActionModal').style.display = 'flex';
        }

        async function processSettlement(status) {
            const id = document.getElementById('settle-id').value;
            const utr = document.getElementById('settle-utr').value;
            const notes = document.getElementById('settle-notes').value;

            const totpCode = document.getElementById('settle-totp').value;
            if (!totpCode) return showToast(_t('totp_required'), 'error');

            try {
                const res = await fetch(`/admin/api/settlements/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status, utr, notes, totpCode })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(_t('settlement_success'));
                    document.getElementById('settleActionModal').style.display = 'none';
                    loadSettlements();
                } else {
                    showToast(data.error, 'error');
                }
            } catch (e) {
                showToast(_t('error_processing_settlement'), 'error');
            }
        }

        function searchMerchants() {
            clearTimeout(merchantSearchTimeout);
            merchantSearchTimeout = setTimeout(() => {
                loadMerchants(1);
            }, 300);
        }

        async function loadMerchants(page = 1) {
            const search = document.getElementById('merchant-search').value;
            const isActive = document.getElementById('merchant-filter-status').value;

            let url = `/admin/api/merchants?page=${page}&search=${search}`;
            if (isActive) url += `&isActive=${isActive}`;

            const res = await fetch(url);
            const data = await res.json();
            const tbody = document.getElementById('merchants-table').querySelector('tbody');

            if (data.success && data.merchants.length > 0) {
                tbody.innerHTML = data.merchants.map(m => `
                    <tr>
                        <td style="font-weight:500;">${m.username}</td>
                        <td><small style="font-family:monospace; background:#F3F4F6; padding:2px 6px; border-radius:4px;">${m.apiKey || '-'}</small></td>
                        <td>
                            <div style="font-size:0.75rem; line-height:1.2;">
                                <span style="color:#6B7280;">${_t('in_label')}</span> ${m.payinChannel || m.assignedChannel || _t('none')}<br>
                                <span style="color:#6B7280;">${_t('out_label')}</span> ${m.payoutChannel || m.assignedChannel || _t('none')}
                            </div>
                        </td>
                        <td>₹${parseFloat(m.balance).toFixed(2)}</td>
                        <td>
                            <div style="font-size:0.7rem; color:#6B7280; line-height:1.2;">
                                ${_t('payin_label_short')} ${JSON.parse(m.channel_rates || '{}').payinRate || 0}%<br>
                                ${_t('payout_label_short')} ${JSON.parse(m.channel_rates || '{}').payoutRate || 0}%
                            </div>
                        </td>
                        <td>
                            <div style="display:flex; gap:0.25rem;">
                                ${m.isActive ? `<i class="ri-checkbox-circle-fill" style="color:var(--success)" title="${_t('account_active_title')}"></i>` : `<i class="ri-close-circle-fill" style="color:var(--danger)" title="${_t('account_suspended_title')}"></i>`}
                                ${m.canPayin ? `<i class="ri-arrow-left-down-line" style="color:var(--success)" title="${_t('payin_enabled')}"></i>` : `<i class="ri-arrow-left-down-line" style="color:var(--danger); text-decoration:line-through" title="${_t('payin_disabled')}"></i>`}
                                ${m.canPayout ? `<i class="ri-arrow-right-up-line" style="color:var(--success)" title="${_t('payout_enabled')}"></i>` : `<i class="ri-arrow-right-up-line" style="color:var(--danger); text-decoration:line-through" title="${_t('payout_disabled')}"></i>`}
                            </div>
                        </td>
                        <td style="display:flex; gap:0.5rem;">
                            <button class="btn" style="padding:0.25rem 0.5rem;" onclick="editMerchant('${m.id}')"><i class="ri-edit-line"></i></button>
                            <button class="btn" style="padding:0.25rem 0.5rem; background:rgba(24, 144, 255, 0.1); color:var(--primary);" onclick="openBalanceAdjustment('${m.id}', '${m.username}', '${m.balance}')" title="<%= t('adjust_balance') %>"><i class="ri-exchange-funds-line"></i></button>
                        </td>
                    </tr>
                `).join('');
                renderPagination(data.pagination, 'merchants-pagination', `loadMerchants({page})`);
            } else {
                tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; color: #9ca3af; padding:2rem;">${_t('no_merchants_found')}</td></tr>`;
                document.getElementById('merchants-pagination').innerHTML = '';
            }
        }

        async function editMerchant(id) {
            const res = await fetch(`/admin/api/merchants/${id}`);
            const data = await res.json();
            if (!data.success) return alert(_t('failed_to_load'));

            const m = data.merchant;
            document.getElementById('m-id').value = m.id;
            document.getElementById('m-username').value = m.username;
            document.getElementById('m-password').value = '';
            document.getElementById('m-payin-channel').value = m.payinChannel || m.assignedChannel || '';
            document.getElementById('m-payout-channel').value = m.payoutChannel || m.assignedChannel || '';
            document.getElementById('m-telegramGroup').value = m.telegramGroupId || '';

            const rates = JSON.parse(m.channel_rates || '{}');
            document.getElementById('m-payin').value = rates.payinRate || 5;
            document.getElementById('m-payout').value = rates.payoutRate || 3;
            document.getElementById('m-fixed').value = rates.payoutFixedFee || 6;
            document.getElementById('m-usdt').value = rates.usdtRate || 100;

            document.getElementById('m-isActive').checked = m.isActive;
            document.getElementById('m-canPayin').checked = m.canPayin;
            document.getElementById('m-canPayout').checked = m.canPayout;

            document.getElementById('btn-delete-merchant').style.display = 'block';
            document.getElementById('m-totp-container').style.display = 'block';
            openMerchantModal();
        }

        function openMerchantModal() {
            document.getElementById('m-totp').value = '';
            document.getElementById('merchantModal').style.display = 'flex';
        }

        async function saveMerchant() {
            const id = document.getElementById('m-id').value;
            const body = {
                username: document.getElementById('m-username').value,
                payinChannel: document.getElementById('m-payin-channel').value,
                payoutChannel: document.getElementById('m-payout-channel').value,
                telegramGroupId: document.getElementById('m-telegramGroup').value,
                payinRate: document.getElementById('m-payin').value,
                payoutRate: document.getElementById('m-payout').value,
                payoutFixedFee: document.getElementById('m-fixed').value,
                usdtRate: document.getElementById('m-usdt').value,
                isActive: document.getElementById('m-isActive').checked,
                canPayin: document.getElementById('m-canPayin').checked,
                canPayout: document.getElementById('m-canPayout').checked
            };

            const p = document.getElementById('m-password').value;
            if (p) body.password = p;

            const res = await fetch(id ? `/admin/api/merchants/${id}` : '/admin/api/merchants', {
                method: id ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });

            const data = await res.json();
            if (data.success) {
                showToast(_t('merchant_saved'));
                document.getElementById('merchantModal').style.display = 'none';
                loadMerchants();
                document.getElementById('m-id').value = '';
                document.getElementById('merchantForm').reset();
                document.getElementById('btn-delete-merchant').style.display = 'none';
            } else {
                showToast(data.error || _t('failed_to_save'), 'error');
            }
        }

        async function deleteMerchantAction() {
            const id = document.getElementById('m-id').value;
            const totpCode = document.getElementById('m-totp').value;
            if (!id) return;
            if (!totpCode) return showToast(_t('totp_required_delete'), 'error');
            if (!confirm(_t('confirm_delete_merchant'))) return;

            const res = await fetch(`/admin/api/merchants/${id}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ totpCode })
            });
            const data = await res.json();
            if (data.success) {
                showToast(_t('merchant_deleted'));
                document.getElementById('merchantModal').style.display = 'none';
                loadMerchants();
            } else {
                showToast(data.error || _t('failed_to_delete'), 'error');
            }
        }

        function openBalanceAdjustment(id, username, balance) {
            document.getElementById('adj-m-id').value = id;
            document.getElementById('adj-merchant-info').innerText = `${username} (Current: ₹${parseFloat(balance).toFixed(2)})`;
            document.getElementById('adj-amount').value = '';
            document.getElementById('adj-note').value = '';
            document.getElementById('adj-totp').value = '';
            document.getElementById('balanceAdjModal').style.display = 'flex';
        }

        async function saveBalanceAdjustment() {
            const id = document.getElementById('adj-m-id').value;
            const type = document.getElementById('adj-type').value;
            const amount = document.getElementById('adj-amount').value;
            const note = document.getElementById('adj-note').value;
            const totpCode = document.getElementById('adj-totp').value;

            if (!amount || amount <= 0) return showToast(_t('invalid_amount'), 'error');
            if (!totpCode) return showToast(_t('totp_required'), 'error');

            try {
                const res = await fetch(`/admin/api/merchants/${id}/adjust-balance`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ type, amount, note, totpCode })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(_t('balance_adjusted'));
                    document.getElementById('balanceAdjModal').style.display = 'none';
                    loadMerchants();
                } else {
                    showToast(data.error || _t('failed_adjust_balance'), 'error');
                }
            } catch (e) {
                showToast(_t('error_adjust_balance'), 'error');
            }
        }

        async function sendBroadcast() {
            const message = document.getElementById('broadcast-msg').value;
            await fetch('/admin/api/broadcast', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message })
            });
            showToast(_t('broadcast_sent'));
        }

        async function loadChannels() {
            const res = await fetch('/admin/api/channels');
            const data = await res.json();
            document.getElementById('channels-table').querySelector('tbody').innerHTML = data.channels.map(c => `
                <tr>
                    <td style="font-weight:600;">${c.displayName}</td>
                    <td>${c.payinRate}%</td>
                    <td>${c.payoutRate}%</td>
                    <td>₹${c.payoutFixedFee}</td>
                    <td>${c.isActive ? `<span class="badge badge-success">${_t('active')}</span>` : `<span class="badge badge-failed">${_t('inactive')}</span>`}</td>
                     <td><button class="btn" style="padding:0.25rem 0.5rem;"><i class="ri-settings-4-line"></i></button></td>
                </tr>
             `).join('');
        }

        async function analyzeChannels() {
            const btn = document.getElementById('btn-analyze');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<i class="ri-loader-4-line ri-spin"></i> ${_t('checking')}`;

            showToast(_t('analysis_starting'), 'info');

            try {
                const res = await fetch('/admin/api/channels/analyze', { method: 'POST' });
                const data = await res.json();

                if (data.success) {
                    let msg = _t('analysis_complete') + '\n';
                    data.results.forEach(r => {
                        msg += `${r.channel}: ${r.success ? '✅ OK' : '❌ ' + (r.error || 'Failed')} \n`;
                    });
                    alert(msg); // Using alert for simplicity as modal is not set up
                } else {
                    showToast(_t('analysis_failed'), 'error');
                }
            } catch (e) {
                showToast(_t('error_analysis'), 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }

        // ===== Smart Channel Functions =====
        async function loadSmartRanges() {
            try {
                const res = await fetch('/admin/api/smart-ranges');

                if (!res.ok) {
                    console.error('API error:', res.status, res.statusText);
                    document.getElementById('smart-ranges-table').querySelector('tbody').innerHTML = `
                        <tr><td colspan="6" style="text-align:center; padding:2rem; color:#EF4444;">${_t('failed_load_ranges')} (${res.status}).</td></tr>
                    `;
                    return;
                }

                const data = await res.json();

                if (!data.success || !data.ranges || data.ranges.length === 0) {
                    document.getElementById('smart-ranges-table').querySelector('tbody').innerHTML = `
                        <tr><td colspan="6" style="text-align:center; padding:2rem;">${_t('no_ranges_smart')}</td></tr>
                    `;
                    return;
                }

                const channelNames = {
                    'aapay': 'AA Pay', 'gaurpay': 'GaurPay', 'yellow': 'Yellow',
                    'upi super': 'UPI Super', 'ckpay': 'CKPay', 'bharatpay': 'BharatPay',
                    'cxpay': 'CX Pay', 'ipay': 'IPay'
                };

                document.getElementById('smart-ranges-table').querySelector('tbody').innerHTML = data.ranges.map(r => `
                    <tr>
                        <td>₹${parseFloat(r.minAmount).toLocaleString()}</td>
                        <td>₹${parseFloat(r.maxAmount).toLocaleString()}</td>
                        <td style="font-weight:600;">${channelNames[r.channelName] || r.channelName}</td>
                        <td>${r.priority}</td>
                        <td>${r.isActive ? `<span class="badge badge-success">${_t('active')}</span>` : `<span class="badge badge-failed">${_t('inactive')}</span>`}</td>
                        <td>
                            <button class="btn" style="padding:0.25rem 0.5rem; margin-right:0.25rem;" onclick="showEditRangeModal(${r.id}, ${r.minAmount}, ${r.maxAmount}, '${r.channelName}', ${r.priority}, ${r.isActive})">
                                <i class="ri-edit-line"></i>
                            </button>
                            <button class="btn" style="padding:0.25rem 0.5rem; color:#EF4444;" onclick="deleteRange(${r.id})">
                                <i class="ri-delete-bin-line"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            } catch (e) {
                console.error('Error loading smart ranges:', e);
                document.getElementById('smart-ranges-table').querySelector('tbody').innerHTML = `
                    <tr><td colspan="6" style="text-align:center; padding:2rem; color:#EF4444;">Error: ${e.message}</td></tr>
                `;
            }
        }

        function showAddRangeModal() {
            document.getElementById('rangeModalTitle').textContent = _t('add_range');
            document.getElementById('range-id').value = '';
            document.getElementById('range-min').value = '';
            document.getElementById('range-max').value = '';
            document.getElementById('range-channel').value = '';
            document.getElementById('range-priority').value = '0';
            document.getElementById('range-active').checked = true;
            document.getElementById('rangeModal').style.display = 'flex';
        }

        function showEditRangeModal(id, min, max, channel, priority, isActive) {
            document.getElementById('rangeModalTitle').textContent = _t('edit_range');
            document.getElementById('range-id').value = id;
            document.getElementById('range-min').value = min;
            document.getElementById('range-max').value = max;
            document.getElementById('range-channel').value = channel;
            document.getElementById('range-priority').value = priority;
            document.getElementById('range-active').checked = isActive;
            document.getElementById('rangeModal').style.display = 'flex';
        }

        function closeRangeModal() {
            document.getElementById('rangeModal').style.display = 'none';
        }

        async function saveRange() {
            const id = document.getElementById('range-id').value;
            const minAmount = document.getElementById('range-min').value;
            const maxAmount = document.getElementById('range-max').value;
            const channelName = document.getElementById('range-channel').value;
            const priority = document.getElementById('range-priority').value;
            const isActive = document.getElementById('range-active').checked;

            if (!minAmount || !maxAmount || !channelName) {
                return showToast(_t('fill_required_fields'), 'error');
            }

            if (parseFloat(minAmount) >= parseFloat(maxAmount)) {
                return showToast(_t('min_less_than_max'), 'error');
            }

            try {
                const url = id ? `/admin/api/smart-ranges/${id}` : '/admin/api/smart-ranges';
                const method = id ? 'PUT' : 'POST';

                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ minAmount, maxAmount, channelName, priority, isActive })
                });

                const data = await res.json();
                if (data.success) {
                    showToast(id ? _t('range_updated') : _t('range_created'));
                    closeRangeModal();
                    loadSmartRanges();
                } else {
                    showToast(data.error || _t('failed_save_range'), 'error');
                }
            } catch (e) {
                showToast(_t('error_save_range'), 'error');
            }
        }

        async function deleteRange(id) {
            if (!confirm(_t('confirm_delete_range'))) return;

            try {
                const res = await fetch(`/admin/api/smart-ranges/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    showToast(_t('range_deleted'));
                    loadSmartRanges();
                } else {
                    showToast(data.error || _t('failed_delete_range'), 'error');
                }
            } catch (e) {
                showToast(_t('error_delete_range'), 'error');
            }
        }

        // ===== Manual Payout Functions =====
        async function loadManualPayouts(page = 1) {
            try {
                const res = await fetch(`/admin/api/manual-payouts?page=${page}`);
                const data = await res.json();
                const tbody = document.getElementById('manual-payouts-table').querySelector('tbody');

                if (data.success && data.payouts.length > 0) {
                    tbody.innerHTML = data.payouts.map(p => {
                        const details = p.payoutDetails;
                        const bankInfo = details ? `${details.bankName}<br><small>${details.accountNumber}</small>` : 'N/A';
                        return `
                        <tr>
                            <td><small style="font-family:monospace;">${p.orderId}</small></td>
                            <td>₹${p.amount}</td>
                            <td>${bankInfo}</td>
                            <td>${p.channelName}</td>
                            <td><span class="badge badge-${p.status}">${p.status}</span></td>
                            <td>${new Date(p.createdAt).toLocaleString()}</td>
                        </tr>
                    `}).join('');
                } else {
                    tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #9ca3af; padding:2rem;">${_t('no_manual_payouts')}</td></tr>`;
                }
            } catch (e) {
                console.error('Error loading manual payouts:', e);
            }
        }

        async function submitManualPayout() {
            const amount = document.getElementById('mp-amount').value;
            const channel = document.getElementById('mp-channel').value;
            const bankName = document.getElementById('mp-bank-name').value;
            const accountNumber = document.getElementById('mp-acc-num').value;
            const ifsc = document.getElementById('mp-ifsc').value;
            const accountHolderName = document.getElementById('mp-holder-name').value;

            if (!amount || !channel || !bankName || !accountNumber || !ifsc || !accountHolderName) {
                return showToast(_t('fill_all_fields'), 'error');
            }

            if (!confirm(_t('confirm_process_payout'))) return;

            try {
                const res = await fetch('/admin/api/manual-payout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        amount, channel, bankName, accountNumber, ifsc, accountHolderName
                    })
                });

                const data = await res.json();
                if (data.success) {
                    showToast(_t('payout_initiated'));
                    // Reset form
                    document.getElementById('mp-amount').value = '';
                    document.getElementById('mp-acc-num').value = '';
                    document.getElementById('mp-ifsc').value = '';
                    document.getElementById('mp-holder-name').value = '';
                    loadManualPayouts();
                } else {
                    showToast(data.error || _t('payout_failed'), 'error');
                }
            } catch (e) {
                showToast(_t('error_processing_payout'), 'error');
            }
        }
    </script>
</body>

</html>