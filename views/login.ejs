<!DOCTYPE html>
<html lang="<%= currentLang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= t('title_login') %>
    </title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', -apple-system, sans-serif;
        }

        html[lang="zh"] body,
        html[lang="zh"] * {
            font-family: 'Inter', 'Noto Sans SC', "Microsoft YaHei", "PingFang SC", -apple-system, sans-serif !important;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(160deg, #FAFAFA 0%, #F5F0EB 40%, #FAF5F0 100%);
            position: relative;
            overflow: hidden;
        }

        /* Decorative warm orbs */
        body::before {
            content: '';
            position: absolute;
            top: -15%;
            left: -10%;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(196, 18, 48, 0.06) 0%, transparent 70%);
            border-radius: 50%;
        }

        body::after {
            content: '';
            position: absolute;
            bottom: -15%;
            right: -10%;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(212, 168, 73, 0.08) 0%, transparent 70%);
            border-radius: 50%;
        }

        /* Subtle pattern overlay */
        .bg-pattern {
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23C41230' fill-opacity='0.015'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
        }

        .login-wrapper {
            display: flex;
            align-items: stretch;
            gap: 0;
            max-width: 900px;
            width: 100%;
            margin: 1rem;
            position: relative;
            z-index: 10;
            animation: fadeUp 0.5s ease-out;
            box-shadow: 0 20px 60px rgba(139, 26, 43, 0.08), 0 8px 24px rgba(0, 0, 0, 0.04);
            border-radius: 16px;
            overflow: hidden;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Left decorative panel */
        .login-side {
            width: 380px;
            background: linear-gradient(160deg, #8B1A2B 0%, #C41230 50%, #D4363E 100%);
            padding: 3rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .login-side::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg width='80' height='80' viewBox='0 0 80 80' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Cpath d='M50 50c0-5.523 4.477-10 10-10s10 4.477 10 10-4.477 10-10 10c0 5.523-4.477 10-10 10s-10-4.477-10-10 4.477-10 10-10zM10 10c0-5.523 4.477-10 10-10s10 4.477 10 10-4.477 10-10 10c0 5.523-4.477 10-10 10S0 25.523 0 20s4.477-10 10-10z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }

        .side-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: white;
        }

        .side-icon {
            width: 80px;
            height: 80px;
            background: rgba(255,255,255,0.12);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.15);
        }

        .side-icon i {
            font-size: 2.5rem;
            color: #FFD700;
        }

        .side-title {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

        .side-desc {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.75);
            line-height: 1.6;
            max-width: 280px;
        }

        .side-features {
            margin-top: 2.5rem;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .side-feature {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: rgba(255,255,255,0.85);
            font-size: 0.85rem;
        }

        .side-feature i {
            color: #FFD700;
            font-size: 1rem;
            width: 20px;
            flex-shrink: 0;
        }

        /* Gold decorative line */
        .gold-divider {
            width: 40px;
            height: 3px;
            background: linear-gradient(90deg, #FFD700, #D4A849);
            border-radius: 2px;
            margin: 1.5rem auto;
        }

        /* Right login form */
        .login-card {
            background: #fff;
            padding: 3rem;
            flex: 1;
            min-width: 0;
            position: relative;
        }

        .lang-switcher {
            position: absolute;
            top: 1.25rem;
            right: 1.25rem;
            display: flex;
            gap: 0.4rem;
        }

        .lang-btn {
            padding: 0.35rem 0.65rem;
            font-size: 0.75rem;
            color: #64748b;
            text-decoration: none;
            border-radius: 6px;
            border: 1px solid #E8E0D8;
            background: white;
            transition: all 0.2s;
        }

        .lang-btn:hover {
            border-color: #C41230;
            color: #C41230;
        }

        .lang-btn.active {
            background: linear-gradient(135deg, #C41230 0%, #D4363E 100%);
            color: white;
            border-color: transparent;
        }

        .brand-section {
            text-align: center;
            margin-bottom: 2rem;
        }

        .brand-logo {
            width: auto;
            max-width: 240px;
            height: auto;
            max-height: 80px;
            margin-bottom: 1.25rem;
            object-fit: contain;
        }

        .brand-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 0.3rem;
        }

        .brand-subtitle {
            font-size: 0.85rem;
            color: #6b7280;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.4rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .input-field {
            position: relative;
        }

        .input-field i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #9CA3AF;
            font-size: 1.1rem;
            transition: color 0.2s;
        }

        .input-field input {
            width: 100%;
            padding: 0.85rem 1rem 0.85rem 2.75rem;
            border: 1.5px solid #E8E0D8;
            border-radius: 10px;
            font-size: 0.95rem;
            transition: all 0.25s ease;
            background: #FAFAF8;
        }

        .input-field input:focus {
            outline: none;
            border-color: #C41230;
            background: white;
            box-shadow: 0 0 0 4px rgba(196, 18, 48, 0.06);
        }

        .input-field input:focus+i,
        .input-field:focus-within i {
            color: #C41230;
        }

        .input-field input::placeholder {
            color: #9CA3AF;
        }

        /* TOTP Section */
        .totp-section {
            display: none;
            animation: fadeIn 0.3s ease-out;
        }

        .totp-section.show {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .totp-divider {
            display: flex;
            align-items: center;
            margin: 1.5rem 0;
            color: #9CA3AF;
            font-size: 0.8rem;
        }

        .totp-divider::before,
        .totp-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, #E8E0D8, #D4A849, #E8E0D8);
        }

        .totp-divider span {
            padding: 0 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .totp-divider i {
            color: #D4A849;
        }

        .totp-input {
            text-align: center;
            font-size: 1.5rem !important;
            letter-spacing: 0.5em;
            font-weight: 600;
            padding-left: 1rem !important;
        }

        .submit-btn {
            width: 100%;
            padding: 0.95rem;
            background: linear-gradient(135deg, #C41230 0%, #D4363E 60%, #D4A849 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 4px 15px rgba(196, 18, 48, 0.25);
            margin-top: 0.5rem;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(196, 18, 48, 0.35);
        }

        .submit-btn:active {
            transform: translateY(0);
        }

        .submit-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

        .submit-btn .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            display: none;
        }

        .submit-btn.loading .spinner {
            display: block;
        }

        .submit-btn.loading .btn-text {
            display: none;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .error-alert {
            padding: 0.8rem 1rem;
            background: #FFF5F5;
            border: 1px solid #FECACA;
            border-radius: 10px;
            color: #dc2626;
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .error-alert i {
            font-size: 1.1rem;
        }

        .success-alert {
            padding: 0.8rem 1rem;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            border-radius: 10px;
            color: #059669;
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Footer */
        .login-footer {
            text-align: center;
            margin-top: 1.5rem;
            padding-top: 1.25rem;
            border-top: 1px solid #E8E0D8;
            color: #9CA3AF;
            font-size: 0.8rem;
        }

        .login-footer span {
            color: #C41230;
            font-weight: 600;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .login-side {
                display: none;
            }

            .login-wrapper {
                max-width: 440px;
                border-radius: 16px;
            }

            .login-card {
                padding: 2.5rem 1.75rem;
                border-radius: 16px;
            }

            .brand-title {
                font-size: 1.3rem;
            }
        }
    </style>
</head>

<body>
    <div class="bg-pattern"></div>

    <div class="login-wrapper">
        <!-- Decorative left panel -->
        <div class="login-side">
            <div class="side-content">
                <div class="side-icon">
                    <i class="ri-shield-keyhole-fill"></i>
                </div>
                <h2 class="side-title">
                    <%= currentLang === 'zh' ? '安全支付平台' : 'Secure Payment Gateway' %>
                </h2>
                <div class="gold-divider"></div>
                <p class="side-desc">
                    <%= currentLang === 'zh' ? '为全球商户提供安全、快速、可靠的支付解决方案' : 'Fast, secure, and reliable payment solutions for global merchants' %>
                </p>
                <div class="side-features">
                    <div class="side-feature">
                        <i class="ri-lock-fill"></i>
                        <span><%= currentLang === 'zh' ? '端到端加密保护' : 'End-to-end encryption' %></span>
                    </div>
                    <div class="side-feature">
                        <i class="ri-speed-fill"></i>
                        <span><%= currentLang === 'zh' ? '毫秒级实时处理' : 'Real-time processing' %></span>
                    </div>
                    <div class="side-feature">
                        <i class="ri-global-fill"></i>
                        <span><%= currentLang === 'zh' ? '多通道智能路由' : 'Multi-channel smart routing' %></span>
                    </div>
                    <div class="side-feature">
                        <i class="ri-customer-service-2-fill"></i>
                        <span><%= currentLang === 'zh' ? '7×24小时专业支持' : '24/7 professional support' %></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Login form -->
        <div class="login-card">
            <div class="lang-switcher">
                <a href="?lang=en" class="lang-btn <%= currentLang === 'en' ? 'active' : '' %>">EN</a>
                <a href="?lang=zh" class="lang-btn <%= currentLang === 'zh' ? 'active' : '' %>">CN</a>
            </div>

            <div class="brand-section">
                <img src="/logo.jpg" alt="Gaur Pay" class="brand-logo">
                <h1 class="brand-title">
                    <%= t('header_welcome') %>
                </h1>
                <p class="brand-subtitle">
                    <%= t('subtitle_login') %>
                </p>
            </div>

            <% if (message && message.length> 0) { %>
                <div class="error-alert">
                    <i class="ri-error-warning-line"></i>
                    <%= message %>
                </div>
            <% } %>

            <div id="success-msg" class="success-alert" style="display:none;">
                <i class="ri-shield-check-line"></i>
                <span id="success-text"></span>
            </div>

            <form id="loginForm" action="/auth/login" method="POST">
                <div id="credentials-section">
                    <div class="form-group">
                        <label class="form-label">
                            <%= t('label_username') %>
                        </label>
                        <div class="input-field">
                            <i class="ri-user-3-line"></i>
                            <input type="text" name="username" id="username" required
                                placeholder="<%= t('ph_username') %>">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <%= t('label_password') %>
                        </label>
                        <div class="input-field">
                            <i class="ri-lock-password-line"></i>
                            <input type="password" name="password" id="password" required
                                placeholder="<%= t('ph_password') %>">
                        </div>
                    </div>
                </div>

                <!-- Dynamic TOTP Section -->
                <div id="totp-section" class="totp-section">
                    <div class="totp-divider">
                        <span><i class="ri-shield-keyhole-line"></i>
                            <%= t('two_factor_auth') %>
                        </span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">
                            <%= t('label_code') %>
                        </label>
                        <div class="input-field">
                            <i class="ri-key-2-line"></i>
                            <input type="text" name="token" id="totp-code" class="totp-input" placeholder="000000"
                                autocomplete="off" maxlength="6" pattern="[0-9]{6}" inputmode="numeric">
                        </div>
                    </div>
                </div>

                <button type="submit" class="submit-btn" id="submitBtn">
                    <div class="spinner"></div>
                    <span class="btn-text">
                        <i class="ri-login-box-line"></i>
                        <%= t('btn_login') %>
                    </span>
                </button>
            </form>

            <div class="login-footer">
                <%= t('powered_by') %> <span>Gaur Pay</span> Gateway
            </div>
        </div>
    </div>

    <script id="translations-data" type="application/json"><%- translations %></script>
    <script>
        const form = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const totpSection = document.getElementById('totp-section');
        const totpInput = document.getElementById('totp-code');
        const successMsg = document.getElementById('success-msg');
        const successText = document.getElementById('success-text');
        const credentialsSection = document.getElementById('credentials-section');

        const translations = JSON.parse(document.getElementById('translations-data').textContent);
        function _t(key) {
            return translations[key] || key;
        }

        let requires2FA = false;
        let pendingUsername = '';
        let pendingPassword = '';

        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value;
            const token = totpInput.value;

            submitBtn.classList.add('loading');
            submitBtn.disabled = true;

            try {
                const response = await fetch('/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ username, password, token: token || undefined })
                });

                const data = await response.json();

                if (data.requires2FA) {
                    requires2FA = true;
                    pendingUsername = username;
                    pendingPassword = password;

                    totpSection.classList.add('show');
                    totpInput.required = true;
                    totpInput.focus();

                    submitBtn.querySelector('.btn-text').innerHTML = '<i class="ri-shield-check-line"></i> ' + _t('verify_login');

                    document.getElementById('username').readOnly = true;
                    document.getElementById('password').readOnly = true;
                    credentialsSection.style.opacity = '0.6';

                    successMsg.style.display = 'flex';
                    successText.textContent = data.message || _t('enter_auth_code');

                } else if (data.success) {
                    successMsg.style.display = 'flex';
                    successText.textContent = _t('login_success');
                    window.location.href = data.redirect || '/';
                } else {
                    showError(data.message || _t('login_failed'));
                }
            } catch (error) {
                showError(_t('connection_error'));
            } finally {
                submitBtn.classList.remove('loading');
                submitBtn.disabled = false;
            }
        });

        function showError(message) {
            let errorDiv = document.querySelector('.error-alert');
            if (!errorDiv) {
                errorDiv = document.createElement('div');
                errorDiv.className = 'error-alert';
                errorDiv.innerHTML = '<i class="ri-error-warning-line"></i><span></span>';
                form.parentNode.insertBefore(errorDiv, form);
            }
            errorDiv.querySelector('span') ? errorDiv.querySelector('span').textContent = message : errorDiv.innerHTML = '<i class="ri-error-warning-line"></i>' + message;
            errorDiv.style.display = 'flex';

            successMsg.style.display = 'none';
        }

        totpInput.addEventListener('input', function (e) {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 6);
        });
    </script>
</body>

</html>