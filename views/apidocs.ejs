<!DOCTYPE html>
<html lang="<%= currentLang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="GaurPay API Documentation - Payment Gateway Integration Guide">
    <title>GaurPay API v3 — Developer Documentation</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <style>
        :root{--bg:#ffffff;--sidebar:#f8f7f5;--border:#e5e2dc;--text:#111827;--muted:#6b7280;--accent:#C41230;--accent-light:#fff1f2;--code-bg:#0f172a;--code-text:#e2e8f0;--success:#059669;--warn:#d97706;--radius:8px;--font:'Inter','Noto Sans SC',sans-serif;--mono:'JetBrains Mono',monospace}
        *{margin:0;padding:0;box-sizing:border-box}
        html[lang="zh"] *{font-family:'Inter','Noto Sans SC',"Microsoft YaHei",sans-serif!important}
        body{font-family:var(--font);background:var(--bg);color:var(--text);display:flex;height:100vh;overflow:hidden}

        /* SIDEBAR */
        .sb{width:260px;background:var(--sidebar);border-right:1px solid var(--border);height:100%;overflow-y:auto;flex-shrink:0;padding:1.25rem;display:flex;flex-direction:column}
        .sb-brand{display:flex;align-items:center;gap:.6rem;font-weight:700;font-size:1.15rem;color:var(--accent);margin-bottom:.5rem;text-decoration:none}
        .sb-brand i{font-size:1.3rem}
        .ver{font-size:.6rem;background:var(--accent-light);color:var(--accent);padding:2px 7px;border-radius:10px;font-weight:600;margin-left:auto}
        .lang-row{display:flex;gap:3px;margin:.75rem 0 1.25rem;background:var(--border);padding:3px;border-radius:var(--radius)}
        .lang-row a{flex:1;text-align:center;padding:.35rem;border-radius:6px;font-size:.78rem;font-weight:500;color:var(--muted);text-decoration:none;transition:.2s}
        .lang-row a.on{background:#fff;color:var(--accent);font-weight:600;box-shadow:0 1px 3px rgba(0,0,0,.06)}
        .sb-section{margin-bottom:1.25rem}
        .sb-title{font-size:.6rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);font-weight:700;margin-bottom:.4rem;padding-left:.6rem}
        .sb a.nl{display:flex;align-items:center;gap:.45rem;padding:.4rem .65rem;color:var(--text);text-decoration:none;font-size:.82rem;border-radius:6px;margin-bottom:1px;font-weight:450;transition:.15s}
        .sb a.nl:hover,.sb a.nl.on{background:var(--accent-light);color:var(--accent)}
        .sb a.nl i{font-size:.85rem;width:16px;text-align:center;opacity:.65}

        /* MAIN CONTENT */
        .main{flex:1;overflow-y:auto;padding:2.5rem 3.5rem;scroll-behavior:smooth}
        section{margin-bottom:3.5rem;max-width:820px;scroll-margin-top:2rem}
        h1{font-size:1.85rem;margin-bottom:.6rem;font-weight:700}
        h1 small{font-size:.85rem;color:var(--muted);font-weight:400;display:block;margin-top:.2rem}
        h2{font-size:1.3rem;margin-bottom:.85rem;padding-bottom:.4rem;border-bottom:1px solid var(--border);font-weight:650;margin-top:0}
        h3{font-size:1rem;margin:1.25rem 0 .6rem;font-weight:600}
        p{line-height:1.7;color:#374151;margin-bottom:.85rem;font-size:.9rem}

        /* ENDPOINT BADGE */
        .ep{display:inline-flex;align-items:center;gap:.5rem;background:#f1f5f9;padding:.45rem .9rem;border-radius:var(--radius);font-family:var(--mono);font-size:.82rem;margin-bottom:1rem;border:1px solid var(--border)}
        .mt{font-weight:700;font-size:.7rem;padding:2px 7px;border-radius:4px;text-transform:uppercase}
        .mt.post{background:#dcfce7;color:#166534}
        .mt.get{background:#dbeafe;color:#1e40af}

        /* TABLE */
        table{width:100%;border-collapse:collapse;margin-bottom:1.25rem;font-size:.83rem;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
        th,td{padding:.6rem .85rem;text-align:left;border-bottom:1px solid var(--border)}
        th{background:var(--sidebar);font-weight:600;color:var(--text);font-size:.77rem;text-transform:uppercase;letter-spacing:.03em}
        td{color:#374151}
        td code{font-size:.8em}
        .rq{color:#ef4444;font-size:.67rem;font-weight:600;background:#fef2f2;padding:2px 5px;border-radius:3px;margin-left:3px}
        .op{color:var(--muted);font-size:.67rem;font-weight:500;background:var(--sidebar);padding:2px 5px;border-radius:3px;margin-left:3px}

        /* CODE */
        code:not(.blk){background:#f1f5f9;padding:.12rem .35rem;border-radius:3px;font-family:var(--mono);font-size:.8em;color:#be123c}
        .cb{position:relative;margin-bottom:1.25rem;background:var(--code-bg);border-radius:var(--radius);overflow:hidden}
        .cb pre{margin:0;padding:1rem 1.15rem;overflow-x:auto;font-size:.8rem;line-height:1.6;color:var(--code-text);font-family:var(--mono)}
        .cb .cp{position:absolute;top:6px;right:6px;background:rgba(255,255,255,.1);border:none;color:#94a3b8;padding:4px 9px;border-radius:4px;cursor:pointer;font-size:.7rem;font-family:var(--font);transition:.2s}
        .cb .cp:hover{background:rgba(255,255,255,.2);color:#fff}

        /* ALERTS */
        .al{padding:.85rem 1rem;border-radius:var(--radius);border-left:4px solid;margin-bottom:1.25rem;font-size:.85rem;line-height:1.55}
        .al-i{background:var(--accent-light);border-color:var(--accent);color:#1e40af}
        .al-w{background:#fef3c7;border-color:var(--warn);color:#92400e}
        .al-s{background:#ecfdf5;border-color:var(--success);color:#065f46}

        /* STATUS BADGES */
        .st{display:inline-block;padding:2px 9px;border-radius:16px;font-size:.7rem;font-weight:600;text-transform:uppercase}
        .st.s{background:#dcfce7;color:#166534}
        .st.f{background:#fef2f2;color:#991b1b}
        .st.p{background:#fef3c7;color:#92400e}
        .st.pr{background:#dbeafe;color:#1e40af}

        /* STEPS */
        .steps{counter-reset:st;list-style:none;padding:0;margin-bottom:1.25rem}
        .steps li{counter-increment:st;padding:.5rem 0 .5rem 2.25rem;position:relative;color:var(--muted);font-size:.88rem;line-height:1.55}
        .steps li::before{content:counter(st);position:absolute;left:0;top:.4rem;width:1.6rem;height:1.6rem;background:var(--accent-light);color:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700}

        /* TABS */
        .tabs{display:flex;gap:0;margin-bottom:0;border-bottom:2px solid var(--border)}
        .tabs button{padding:.4rem .85rem;font-size:.78rem;font-weight:500;color:var(--muted);background:none;border:none;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:.15s;font-family:var(--font)}
        .tabs button.on{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
        .tc{display:none}.tc.on{display:block}

        /* MOBILE */
        .mob-btn{display:none;position:fixed;top:.8rem;left:.8rem;z-index:200;background:var(--accent);color:#fff;border:none;width:36px;height:36px;border-radius:var(--radius);cursor:pointer;font-size:1.1rem;align-items:center;justify-content:center}
        @media(max-width:1024px){
            .sb{position:fixed;z-index:150;transform:translateX(-100%);transition:.3s}.sb.show{transform:translateX(0)}
            .mob-btn{display:flex}.main{padding:2rem 1.25rem;padding-top:3rem}
        }
    </style>
</head>
<body>
    <button class="mob-btn" onclick="document.querySelector('.sb').classList.toggle('show')"><i class="ri-menu-line"></i></button>

    <aside class="sb">
        <a href="/" class="sb-brand"><i class="ri-shield-keyhole-fill"></i> GaurPay <span class="ver">v3.0</span></a>
        <div class="lang-row">
            <a href="?lang=en" class="<%= currentLang==='en'?'on':'' %>">English</a>
            <a href="?lang=zh" class="<%= currentLang==='zh'?'on':'' %>">中文</a>
        </div>
        <nav>
            <div class="sb-section">
                <div class="sb-title"><%= currentLang==='zh'?'入门':'GETTING STARTED' %></div>
                <a href="#intro" class="nl"><i class="ri-book-open-line"></i> <%= currentLang==='zh'?'概述':'Overview' %></a>
                <a href="#auth" class="nl"><i class="ri-key-2-line"></i> <%= currentLang==='zh'?'签名认证':'Authentication' %></a>
                <a href="#format" class="nl"><i class="ri-code-s-slash-line"></i> <%= currentLang==='zh'?'请求格式':'Request Format' %></a>
            </div>
            <div class="sb-section">
                <div class="sb-title"><%= currentLang==='zh'?'充值 (入金)':'DEPOSIT (PAY-IN)' %></div>
                <a href="#dep-create" class="nl"><i class="ri-add-circle-line"></i> <%= currentLang==='zh'?'创建充值':'Create Deposit' %></a>
                <a href="#dep-query" class="nl"><i class="ri-search-line"></i> <%= currentLang==='zh'?'查询状态':'Query Status' %></a>
                <a href="#dep-callback" class="nl"><i class="ri-notification-line"></i> <%= currentLang==='zh'?'回调通知':'Callback' %></a>
                <a href="#dep-submit-ref" class="nl"><i class="ri-send-plane-line"></i> <%= currentLang==='zh'?'提交凭证':'Submit Ref' %></a>
                <a href="#dep-check-ref" class="nl"><i class="ri-file-search-line"></i> <%= currentLang==='zh'?'查询凭证':'Check Ref' %></a>
            </div>
            <div class="sb-section">
                <div class="sb-title"><%= currentLang==='zh'?'提现 (出金)':'WITHDRAW (PAY-OUT)' %></div>
                <a href="#wd-bank" class="nl"><i class="ri-bank-line"></i> <%= currentLang==='zh'?'银行提现':'Bank Transfer' %></a>
                <a href="#wd-upi" class="nl"><i class="ri-smartphone-line"></i> <%= currentLang==='zh'?'UPI 提现':'UPI Transfer' %></a>
                <a href="#wd-query" class="nl"><i class="ri-search-line"></i> <%= currentLang==='zh'?'查询状态':'Query Status' %></a>
                <a href="#wd-callback" class="nl"><i class="ri-notification-line"></i> <%= currentLang==='zh'?'回调通知':'Callback' %></a>
            </div>
            <div class="sb-section">
                <div class="sb-title"><%= currentLang==='zh'?'钱包':'WALLET' %></div>
                <a href="#wallet" class="nl"><i class="ri-wallet-3-line"></i> <%= currentLang==='zh'?'查询余额':'Balance' %></a>
            </div>
            <div class="sb-section">
                <div class="sb-title"><%= currentLang==='zh'?'参考':'REFERENCE' %></div>
                <a href="#errors" class="nl"><i class="ri-error-warning-line"></i> <%= currentLang==='zh'?'错误码':'Error Codes' %></a>
                <a href="#ip" class="nl"><i class="ri-shield-check-line"></i> <%= currentLang==='zh'?'IP 白名单':'IP Whitelist' %></a>
                <a href="#tips" class="nl"><i class="ri-lightbulb-line"></i> <%= currentLang==='zh'?'最佳实践':'Best Practices' %></a>
            </div>
        </nav>
    </aside>

    <main class="main">

        <!-- INTRO -->
        <section id="intro">
            <% if(currentLang==='zh'){ %>
            <h1>GaurPay API v3 文档 <small>安全可靠的支付网关集成指南</small></h1>
            <p>欢迎使用 GaurPay 支付网关 API v3。本文档提供完整的充值（入金）和提现（出金）接口集成指南。</p>
            <div class="al al-i"><strong>基础 URL：</strong> <code>https://gaurpay.site</code><br>所有请求须通过 HTTPS 发送，Content-Type 为 <code>application/json</code>。</div>
            <% } else { %>
            <h1>GaurPay API v3 Documentation <small>Secure payment gateway integration guide</small></h1>
            <p>Welcome to the GaurPay API v3. This documentation covers everything you need to integrate our deposit (pay-in) and withdrawal (pay-out) services.</p>
            <div class="al al-i"><strong>Base URL:</strong> <code>https://gaurpay.site</code><br>All requests must use HTTPS with <code>Content-Type: application/json</code>.</div>
            <% } %>
        </section>

        <!-- AUTH -->
        <section id="auth">
            <% if(currentLang==='zh'){ %>
            <h2>签名认证</h2>
            <p>所有 API 请求需要通过 HTTP Header 进行身份验证。请在商户后台获取 API Key 和 Secret。</p>
            <% } else { %>
            <h2>Authentication</h2>
            <p>All API requests require header-based authentication. Obtain your API Key and Secret from the merchant dashboard.</p>
            <% } %>
            <table>
                <thead><tr><th>Header</th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr></thead>
                <tbody>
                    <tr><td><code>x-merchant-id</code></td><td><%= currentLang==='zh'?'商户 API Key':'Your Merchant API Key' %></td></tr>
                    <tr><td><code>x-signature</code></td><td><%= currentLang==='zh'?'请求参数的 MD5 签名（大写）':'MD5 signature of request params (uppercase)' %></td></tr>
                    <tr><td><code>Content-Type</code></td><td><code>application/json</code></td></tr>
                </tbody>
            </table>
            <h3><%= currentLang==='zh'?'签名步骤':'Signature Steps' %></h3>
            <ol class="steps">
                <li><%= currentLang==='zh'?'将请求参数按键名 ASCII 升序排序（排除空值和 sign 字段）':'Sort all body params by key name (ASCII ascending). Exclude empty values and the sign field.' %></li>
                <li><%= currentLang==='zh'?'拼接为 key1=value1&key2=value2 格式':'Concatenate as key1=value1&key2=value2' %></li>
                <li><%= currentLang==='zh'?'末尾追加 &secret=YOUR_SECRET':'Append &secret=YOUR_SECRET' %></li>
                <li><%= currentLang==='zh'?'计算 MD5 并转大写':'Compute MD5 hash and convert to UPPERCASE' %></li>
            </ol>
            <h3><%= currentLang==='zh'?'代码示例':'Code Example' %></h3>
            <div class="cb"><button class="cp" onclick="copyCode(this)">Copy</button>
<pre><code class="blk">const crypto = require('crypto');

function sign(params, secret) {
    const filtered = {};
    Object.keys(params).forEach(k => {
        if (k !== 'sign' && params[k] !== '' && params[k] != null)
            filtered[k] = params[k];
    });
    const sorted = Object.keys(filtered).sort();
    const qs = sorted.map(k => `${k}=${filtered[k]}`).join('&');
    return crypto.createHash('md5').update(`${qs}&secret=${secret}`).digest('hex').toUpperCase();
}

// Usage
const params = { ref_id: 'DEP_001', txn_amount: 500, webhook_url: 'https://yoursite.com/hook' };
const signature = sign(params, 'YOUR_SECRET');

const res = await fetch('https://gaurpay.site/v3/deposit/create', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-merchant-id': 'YOUR_KEY', 'x-signature': signature },
    body: JSON.stringify(params)
});</code></pre></div>
        </section>

        <!-- REQUEST FORMAT -->
        <section id="format">
            <% if(currentLang==='zh'){ %>
            <h2>请求格式</h2>
            <p>所有 API 响应遵循统一 JSON 格式：</p>
            <h3>成功响应</h3>
            <% } else { %>
            <h2>Request & Response Format</h2>
            <p>All API responses follow a standardized JSON envelope:</p>
            <h3>Success Response</h3>
            <% } %>
            <div class="cb"><button class="cp" onclick="copyCode(this)">Copy</button>
<pre><code class="blk">{
    "status": "success",
    "message": "Operation completed",
    "ts": "2026-04-12T12:00:00.000Z",
    "data": { ... }
}</code></pre></div>
            <h3><%= currentLang==='zh'?'错误响应':'Error Response' %></h3>
            <div class="cb"><button class="cp" onclick="copyCode(this)">Copy</button>
<pre><code class="blk">{
    "status": "error",
    "message": "Missing required fields: ref_id",
    "ts": "2026-04-12T12:00:00.000Z"
}</code></pre></div>
            <h3><%= currentLang==='zh'?'订单状态':'Order States' %></h3>
            <table>
                <thead><tr><th><%= currentLang==='zh'?'状态':'State' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr></thead>
                <tbody>
                    <tr><td><span class="st p">pending</span></td><td><%= currentLang==='zh'?'订单已创建，等待支付':'Order created, awaiting payment' %></td></tr>
                    <tr><td><span class="st pr">processing</span></td><td><%= currentLang==='zh'?'支付处理中':'Payment is being processed' %></td></tr>
                    <tr><td><span class="st s">success</span></td><td><%= currentLang==='zh'?'交易成功':'Transaction completed' %></td></tr>
                    <tr><td><span class="st f">failed</span></td><td><%= currentLang==='zh'?'交易失败':'Transaction failed' %></td></tr>
                </tbody>
            </table>
        </section>

        <!-- DEPOSIT CREATE -->
        <section id="dep-create">
            <% if(currentLang==='zh'){ %>
            <h2>创建充值订单</h2>
            <p>创建新的充值订单，系统返回支付链接供客户完成付款。</p>
            <% } else { %>
            <h2>Create Deposit</h2>
            <p>Create a new deposit order. The API returns a checkout URL to redirect the customer for payment.</p>
            <% } %>
            <div class="ep"><span class="mt post">POST</span> /v3/deposit/create</div>
            <h3><%= currentLang==='zh'?'请求参数':'Request Parameters' %></h3>
            <table>
                <thead><tr><th><%= currentLang==='zh'?'参数':'Param' %></th><th><%= currentLang==='zh'?'类型':'Type' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr></thead>
                <tbody>
                    <tr><td><code>ref_id</code></td><td>String<span class="rq"><%= currentLang==='zh'?'必填':'Required' %></span></td><td><%= currentLang==='zh'?'商户唯一订单号（最大64字符）':'Unique merchant order ID (max 64 chars)' %></td></tr>
                    <tr><td><code>txn_amount</code></td><td>Number<span class="rq"><%= currentLang==='zh'?'必填':'Required' %></span></td><td><%= currentLang==='zh'?`充值金额 ${currency.code}（最低 ${currency.symbol}${currency.minPayin}）`:`Amount in ${currency.code} (min ${currency.symbol}${currency.minPayin})` %></td></tr>
                    <tr><td><code>webhook_url</code></td><td>String<span class="rq"><%= currentLang==='zh'?'必填':'Required' %></span></td><td><%= currentLang==='zh'?'异步回调通知地址':'Async webhook URL for notifications' %></td></tr>
                    <tr><td><code>return_url</code></td><td>String<span class="op"><%= currentLang==='zh'?'可选':'Optional' %></span></td><td><%= currentLang==='zh'?'支付成功跳转地址':'Redirect URL after payment' %></td></tr>
                    <tr><td><code>payer_name</code></td><td>String<span class="op"><%= currentLang==='zh'?'可选':'Optional' %></span></td><td><%= currentLang==='zh'?'付款人姓名':'Payer name' %></td></tr>
                    <tr><td><code>payer_email</code></td><td>String<span class="op"><%= currentLang==='zh'?'可选':'Optional' %></span></td><td><%= currentLang==='zh'?'付款人邮箱':'Payer email' %></td></tr>
                    <tr><td><code>payer_phone</code></td><td>String<span class="op"><%= currentLang==='zh'?'可选':'Optional' %></span></td><td><%= currentLang==='zh'?'付款人电话':'Payer phone' %></td></tr>
                    <tr><td><code>metadata</code></td><td>String<span class="op"><%= currentLang==='zh'?'可选':'Optional' %></span></td><td><%= currentLang==='zh'?'自定义透传数据（回调原样返回）':'Custom passthrough data (returned in callback)' %></td></tr>
                </tbody>
            </table>
            <h3><%= currentLang==='zh'?'请求示例':'Example Request' %></h3>
            <div class="cb"><button class="cp" onclick="copyCode(this)">Copy</button>
<pre><code class="blk">curl -X POST https://gaurpay.site/v3/deposit/create \
  -H "Content-Type: application/json" \
  -H "x-merchant-id: YOUR_KEY" \
  -H "x-signature: A1B2C3D4..." \
  -d '{
    "ref_id": "DEP_20260412_001",
    "txn_amount": 500,
    "webhook_url": "https://yoursite.com/hook/deposit",
    "return_url": "https://yoursite.com/success",
    "payer_name": "Test User",
    "metadata": "uid_123"
  }'</code></pre></div>
            <h3><%= currentLang==='zh'?'成功响应':'Success Response' %></h3>
            <div class="cb"><button class="cp" onclick="copyCode(this)">Copy</button>
<pre><code class="blk">{
    "status": "success",
    "message": "Deposit order created",
    "ts": "2026-04-12T12:00:00.000Z",
    "data": {
        "ref_id": "DEP_20260412_001",
        "trace_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
        "txn_amount": 500.00,
        "service_fee": 25.00,
        "checkout_url": "https://gaurpay.site/pay/a1b2c3d4-e5f6-...",
        "vpa": "merchant@upi",
        "deep_links": {
            "upi_phonepe": "phonepe://...",
            "upi_paytm": "paytmmp://...",
            "upi_gpay": "gpay://...",
            "upi_scan": "upi://pay?pa=..."
        },
        "ttl": 1800
    }
}</code></pre></div>
            <h3><%= currentLang==='zh'?'响应字段':'Response Fields' %></h3>
            <table>
                <thead><tr><th><%= currentLang==='zh'?'字段':'Field' %></th><th><%= currentLang==='zh'?'说明':'Description' %></th></tr></thead>
                <tbody>
                    <tr><td><code>checkout_url</code></td><td><%= currentLang==='zh'?'支付页面 URL':'Payment checkout page URL' %></td></tr>
                    <tr><td><code>vpa</code></td><td><%= currentLang==='zh'?'UPI VPA 地址（如可用）':'UPI VPA address (when available)' %></td></tr>
                    <tr><td><code>deep_links</code></td><td><%= currentLang==='zh'?'UPI 应用深度链接（如可用）':'UPI app deep links (when available)' %></td></tr>
                    <tr><td><code>ttl</code></td><td><%= currentLang==='zh'?'订单有效时间（秒）':'Order validity in seconds' %></td></tr>
                </tbody>
            </table>
