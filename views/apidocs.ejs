                    <tr><td>400</td><td><code>INVALID_PARAMS</code></td><td><%= currentLang==='zh'?'参数缺失或格式错误':'Missing or invalid parameters' %></td></tr>
                    <tr><td>401</td><td><code>INVALID_SIGNATURE</code></td><td><%= currentLang==='zh'?'签名验证失败':'Signature verification failed' %></td></tr>
                    <tr><td>401</td><td><code>INVALID_MERCHANT</code></td><td><%= currentLang==='zh'?'商户 ID 无效':'Invalid merchant API Key' %></td></tr>
                    <tr><td>403</td><td><code>IP_NOT_WHITELISTED</code></td><td><%= currentLang==='zh'?'请求 IP 不在白名单':'Request IP not whitelisted' %></td></tr>
                    <tr><td>403</td><td><code>SERVICE_SUSPENDED</code></td><td><%= currentLang==='zh'?'服务已暂停':'Service suspended' %></td></tr>
                    <tr><td>409</td><td><code>DUPLICATE_ORDER</code></td><td><%= currentLang==='zh'?'订单号重复':'Duplicate ref_id' %></td></tr>
