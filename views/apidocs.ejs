<!DOCTYPE html>
<html lang="<%= currentLang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GaurPay API Documentation</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --bg-body: #f8fafc;
            --bg-sidebar: #ffffff;
            --bg-content: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --code-bg: #f1f5f9;
            --success: #10b981;
            --warning: #f59e0b;
            --error: #ef4444;
            --sidebar-width: 280px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            line-height: 1.6;
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            padding: 1.5rem;
            z-index: 100;
        }

        .logo {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .lang-switch {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            background: var(--bg-body);
            padding: 0.25rem;
            border-radius: 0.5rem;
        }

        .lang-btn {
            flex: 1;
            padding: 0.5rem;
            text-align: center;
            border-radius: 0.375rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-muted);
            text-decoration: none;
            transition: all 0.2s;
        }

        .lang-btn.active {
            background-color: white;
            color: var(--primary);
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
            font-weight: 600;
        }

        .nav-group {
            margin-bottom: 1.5rem;
        }

        .nav-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .nav-link {
            display: block;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: var(--text-main);
            text-decoration: none;
            border-radius: 0.375rem;
            transition: background-color 0.2s;
            margin-bottom: 0.25rem;
        }

        .nav-link:hover {
            background-color: var(--bg-body);
            color: var(--primary);
        }

        .nav-link.active {
            background-color: #eff6ff;
            color: var(--primary);
            font-weight: 500;
        }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 3rem 4rem;
            flex: 1;
            max-width: 1000px;
        }

        section {
            margin-bottom: 4rem;
            scroll-margin-top: 2rem;
        }

        h1 {
            font-size: 2.25rem;
            margin-bottom: 1.5rem;
            color: var(--text-main);
        }

        h2 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--border);
            color: var(--text-main);
        }

        h3 {
            font-size: 1.125rem;
            margin: 1.5rem 0 1rem;
            color: var(--text-main);
        }

        p {
            margin-bottom: 1rem;
            color: var(--text-muted);
        }

        /* Endpoint Badge */
        .endpoint-badge {
            display: inline-flex;
            align-items: center;
            background-color: var(--code-bg);
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
            border: 1px solid var(--border);
        }

        .method {
            font-weight: 700;
            margin-right: 0.75rem;
            text-transform: uppercase;
        }

        .method.post {
            color: var(--success);
        }

        .method.get {
            color: var(--primary);
        }

        .url {
            color: var(--text-main);
        }

        /* Request/Response Tables */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            overflow: hidden;
        }

        th,
        td {
            padding: 0.75rem 1rem;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        th {
            background-color: var(--bg-body);
            font-weight: 600;
            color: var(--text-main);
        }

        td {
            color: var(--text-muted);
        }

        code {
            font-family: 'JetBrains Mono', monospace;
            background-color: var(--code-bg);
            padding: 0.2rem 0.4rem;
            border-radius: 0.25rem;
            font-size: 0.8em;
            color: var(--primary);
        }

        .required {
            color: var(--error);
            font-size: 0.75rem;
            font-weight: 500;
            background: #fef2f2;
            padding: 2px 6px;
            border-radius: 4px;
            margin-left: 0.5rem;
        }

        /* Code Blocks */
        pre {
            background-color: #1e293b;
            color: #f8fafc;
            padding: 1.5rem;
            border-radius: 0.5rem;
            overflow-x: auto;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
            position: relative;
        }

        pre code {
            background: none;
            color: inherit;
            padding: 0;
            font-size: inherit;
        }

        .copy-btn {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            cursor: pointer;
            font-size: 0.75rem;
            transition: background 0.2s;
        }

        .copy-btn:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* Alerts */
        .alert {
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
            border-left: 4px solid;
        }

        .alert-info {
            background-color: #eff6ff;
            border-color: var(--primary);
            color: #1e40af;
        }

        .alert-warning {
            background-color: #fefce8;
            border-color: var(--warning);
            color: #854d0e;
        }

        @media (max-width: 1024px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s;
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
                padding: 2rem;
            }

            .menu-toggle {
                display: block;
                position: fixed;
                top: 1rem;
                left: 1rem;
                z-index: 200;
                background: white;
                border: 1px solid var(--border);
                padding: 0.5rem;
                border-radius: 0.25rem;
            }
        }
    </style>
</head>

<body>
    <!-- Language Toggle Script -->
    <script>
        function setLang(lang) {
            const url = new URL(window.location);
            url.searchParams.set('lang', lang);
            window.location.href = url.toString();
        }
    </script>

    <aside class="sidebar">
        <div class="logo">
            <i class="fas fa-layer-group"></i> GaurPay API
        </div>

        <div class="lang-switch">
            <a href="?lang=en" class="lang-btn <%= currentLang === 'en' ? 'active' : '' %>">English</a>
            <a href="?lang=zh" class="lang-btn <%= currentLang === 'zh' ? 'active' : '' %>">中文</a>
        </div>

        <nav>
            <div class="nav-group">
                <div class="nav-title">
                    <%= currentLang==='zh' ? '概览' : 'Overview' %>
                </div>
                <a href="#intro" class="nav-link">
                    <%= currentLang==='zh' ? '简介' : 'Introduction' %>
                </a>
                <a href="#auth" class="nav-link">
                    <%= currentLang==='zh' ? '身份验证' : 'Authentication' %>
                </a>
                <a href="#errors" class="nav-link">
                    <%= currentLang==='zh' ? '错误代码' : 'Error Codes' %>
                </a>
            </div>

            <div class="nav-group">
                <div class="nav-title">
                    <%= currentLang==='zh' ? '收款 (Payin)' : 'Collection (Payin)' %>
                </div>
                <a href="#payin-create" class="nav-link">
                    <%= currentLang==='zh' ? '创建订单' : 'Create Order' %>
                </a>
                <a href="#payin-status" class="nav-link">
                    <%= currentLang==='zh' ? '查询状态' : 'Query Status' %>
                </a>
            </div>

            <div class="nav-group">
                <div class="nav-title">
                    <%= currentLang==='zh' ? '代付 (Payout)' : 'Transfer (Payout)' %>
                </div>
                <a href="#payout-create" class="nav-link">
                    <%= currentLang==='zh' ? '创建代付' : 'Create Transfer' %>
                </a>
                <a href="#payout-status" class="nav-link">
                    <%= currentLang==='zh' ? '查询状态' : 'Query Status' %>
                </a>
            </div>

            <div class="nav-group">
                <div class="nav-title">
                    <%= currentLang==='zh' ? '账户' : 'Account' %>
                </div>
                <a href="#balance" class="nav-link">
                    <%= currentLang==='zh' ? '查询余额' : 'Check Balance' %>
                </a>
            </div>
        </nav>
    </aside>

    <main class="main-content">
        <% if (currentLang==='zh' ) { %>
            <!-- CHINESE CONTENT -->
            <section id="intro">
                <h1>API 文档</h1>
                <p>欢迎使用 GaurPay 支付网关 API。本文档将帮助您快速集成我们的安全支付解决方案。</p>
                <div class="alert alert-info">
                    <strong>注意：</strong> 所有请求必须使用 HTTPS 协议，且 Content-Type 为 <code>application/json</code>。
                </div>
            </section>

            <section id="auth">
                <h2>身份验证</h2>
                <p>所有 API 请求都需要通过 HTTP Header 进行身份验证。</p>
                <table>
                    <thead>
                        <tr>
                            <th>Header 名称</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>x-merchant-id</code></td>
                            <td>您的商户 API Key</td>
                        </tr>
                        <tr>
                            <td><code>x-signature</code></td>
                            <td>请求参数的 MD5 签名</td>
                        </tr>
                    </tbody>
                </table>

                <h3>签名生成步骤</h3>
                <ol style="margin-left: 1.5rem; color: var(--text-muted); margin-bottom: 1.5rem;">
                    <li>将所有请求参数按键名 ASCII 码从小到大排序（排除空值和 <code>sign</code> 字段）。</li>
                    <li>使用 <code>&</code> 符号拼接参数为 <code>key=value</code> 格式。</li>
                    <li>在拼接后的字符串末尾加上 <code>&secret=您的API密钥</code>。</li>
                    <li>对最终字符串进行 MD5 加密，并转为大写。</li>
                </ol>
            </section>

            <section id="payin-create">
                <h2>创建收款订单</h2>
                <p>生成支付链接以接收用户付款。</p>
                <div class="endpoint-badge">
                    <span class="method post">POST</span>
                    <span class="url">/api/payin/create</span>
                </div>

                <h3>请求参数</h3>
                <table>
                    <thead>
                        <tr>
                            <th>参数</th>
                            <th>类型</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>orderId</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>商户唯一订单号</td>
                        </tr>
                        <tr>
                            <td><code>orderAmount</code></td>
                            <td>Number<span class="required">必填</span></td>
                            <td>订单金额</td>
                        </tr>
                        <tr>
                            <td><code>customerName</code></td>
                            <td>String</td>
                            <td>客户姓名</td>
                        </tr>
                        <tr>
                            <td><code>customerEmail</code></td>
                            <td>String</td>
                            <td>客户邮箱</td>
                        </tr>
                        <tr>
                            <td><code>customerPhone</code></td>
                            <td>String</td>
                            <td>客户电话</td>
                        </tr>
                        <tr>
                            <td><code>callbackUrl</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>异步通知回调地址</td>
                        </tr>
                        <tr>
                            <td><code>returnUrl</code></td>
                            <td>String</td>
                            <td>支付成功后跳转地址</td>
                        </tr>
                    </tbody>
                </table>

                <h3>成功响应</h3>
                <pre><code>{
    "status": "success",
    "message": "Order created successfully",
    "result": {
        "merchantOrderId": "TEST_123",
        "paymentUrl": "https://...",
        "requestedAmount": 100.00
    }
}</code></pre>
            </section>

            <section id="payin-status">
                <h2>查询收款状态</h2>
                <div class="endpoint-badge">
                    <span class="method post">POST</span>
                    <span class="url">/api/payin/query</span>
                </div>
                <h3>请求参数</h3>
                <table>
                    <thead>
                        <tr>
                            <th>参数</th>
                            <th>类型</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>orderId</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>商户订单号</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section id="payout-create">
                <h2>创建代付订单</h2>
                <p>发起单笔代付到银行账户。</p>
                <div class="endpoint-badge">
                    <span class="method post">POST</span>
                    <span class="url">/api/payout/bank</span>
                </div>

                <h3>请求参数</h3>
                <table>
                    <thead>
                        <tr>
                            <th>参数</th>
                            <th>类型</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>orderId</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>商户唯一订单号</td>
                        </tr>
                        <tr>
                            <td><code>amount</code></td>
                            <td>Number<span class="required">必填</span></td>
                            <td>代付金额</td>
                        </tr>
                        <tr>
                            <td><code>account</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>收款银行账号</td>
                        </tr>
                        <tr>
                            <td><code>ifsc</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>银行 IFSC 代码</td>
                        </tr>
                        <tr>
                            <td><code>personName</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>收款人姓名</td>
                        </tr>
                        <tr>
                            <td><code>callbackUrl</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>异步通知回调地址</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section id="payout-status">
                <h2>查询代付状态</h2>
                <div class="endpoint-badge">
                    <span class="method post">POST</span>
                    <span class="url">/api/payout/query</span>
                </div>
                <h3>请求参数</h3>
                <table>
                    <thead>
                        <tr>
                            <th>参数</th>
                            <th>类型</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>orderId</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>商户订单号</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section id="balance">
                <h2>查询余额</h2>
                <div class="endpoint-badge">
                    <span class="method post">POST</span>
                    <span class="url">/api/balance/query</span>
                </div>
                <p>无需参数，仅需签名验证。</p>
            </section>

            <section id="errors">
                <h2>错误代码</h2>
                <table>
                    <thead>
                        <tr>
                            <th>代码</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>INVALID_SIGNATURE</code></td>
                            <td>签名无效</td>
                        </tr>
                        <tr>
                            <td><code>INVALID_MERCHANT</code></td>
                            <td>商户无效或未找到</td>
                        </tr>
                        <tr>
                            <td><code>INSUFFICIENT_BALANCE</code></td>
                            <td>余额不足</td>
                        </tr>
                        <tr>
                            <td><code>DUPLICATE_ORDER</code></td>
                            <td>订单号重复</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <% } else { %>
                <!-- ENGLISH CONTENT -->
                <section id="intro">
                    <h1>API Documentation</h1>
                    <p>Welcome to the GaurPay Payment Gateway API. This documentation will help you integrate our secure
                        payment solutions.</p>
                    <div class="alert alert-info">
                        <strong>Note:</strong> All requests must be made over HTTPS with
                        <code>Content-Type: application/json</code>.
                    </div>
                </section>

                <section id="auth">
                    <h2>Authentication</h2>
                    <p>All API requests require authentication via HTTP Headers.</p>
                    <table>
                        <thead>
                            <tr>
                                <th>Header Name</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>x-merchant-id</code></td>
                                <td>Your Merchant API Key</td>
                            </tr>
                            <tr>
                                <td><code>x-signature</code></td>
                                <td>MD5 Signature of request parameters</td>
                            </tr>
                        </tbody>
                    </table>

                    <h3>Signature Generation</h3>
                    <ol style="margin-left: 1.5rem; color: var(--text-muted); margin-bottom: 1.5rem;">
                        <li>Sort all request parameters by key (ASCII ascending). Exclude empty values and
                            <code>sign</code> field.</li>
                        <li>Join parameters in <code>key=value</code> format using <code>&</code>.</li>
                        <li>Append <code>&secret=YOUR_API_SECRET</code> to the string.</li>
                        <li>Generate MD5 hash of the string and convert to UPPERCASE.</li>
                    </ol>
                </section>

                <section id="payin-create">
                    <h2>Create Collection Order</h2>
                    <p>Generate a payment link to receive funds from users.</p>
                    <div class="endpoint-badge">
                        <span class="method post">POST</span>
                        <span class="url">/api/payin/create</span>
                    </div>

                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>orderId</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Unique Merchant Order ID</td>
                            </tr>
                            <tr>
                                <td><code>orderAmount</code></td>
                                <td>Number<span class="required">Required</span></td>
                                <td>Transaction Amount</td>
                            </tr>
                            <tr>
                                <td><code>customerName</code></td>
                                <td>String</td>
                                <td>Customer Name</td>
                            </tr>
                            <tr>
                                <td><code>customerEmail</code></td>
                                <td>String</td>
                                <td>Customer Email</td>
                            </tr>
                            <tr>
                                <td><code>customerPhone</code></td>
                                <td>String</td>
                                <td>Customer Phone</td>
                            </tr>
                            <tr>
                                <td><code>callbackUrl</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Webhook URL for notifications</td>
                            </tr>
                            <tr>
                                <td><code>returnUrl</code></td>
                                <td>String</td>
                                <td>Redirect URL after success</td>
                            </tr>
                        </tbody>
                    </table>

                    <h3>Success Response</h3>
                    <pre><code>{
    "status": "success",
    "message": "Order created successfully",
    "result": {
        "merchantOrderId": "TEST_123",
        "paymentUrl": "https://...",
        "requestedAmount": 100.00
    }
}</code></pre>
                </section>

                <section id="payin-status">
                    <h2>Query Collection Status</h2>
                    <div class="endpoint-badge">
                        <span class="method post">POST</span>
                        <span class="url">/api/payin/query</span>
                    </div>
                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>orderId</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Merchant Order ID</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section id="payout-create">
                    <h2>Create Transfer (Payout)</h2>
                    <p>Initiate a bank transfer payout.</p>
                    <div class="endpoint-badge">
                        <span class="method post">POST</span>
                        <span class="url">/api/payout/bank</span>
                    </div>

                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>orderId</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Unique Merchant Order ID</td>
                            </tr>
                            <tr>
                                <td><code>amount</code></td>
                                <td>Number<span class="required">Required</span></td>
                                <td>Payout Amount</td>
                            </tr>
                            <tr>
                                <td><code>account</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Bank Account Number</td>
                            </tr>
                            <tr>
                                <td><code>ifsc</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Bank IFSC Code</td>
                            </tr>
                            <tr>
                                <td><code>personName</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Beneficiary Name</td>
                            </tr>
                            <tr>
                                <td><code>callbackUrl</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Webhook URL for notifications</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section id="payout-status">
                    <h2>Query Transfer Status</h2>
                    <div class="endpoint-badge">
                        <span class="method post">POST</span>
                        <span class="url">/api/payout/query</span>
                    </div>
                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>orderId</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Merchant Order ID</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section id="balance">
                    <h2>Check Balance</h2>
                    <div class="endpoint-badge">
                        <span class="method post">POST</span>
                        <span class="url">/api/balance/query</span>
                    </div>
                    <p>No parameters required. Authentication signature only.</p>
                </section>

                <section id="errors">
                    <h2>Error Codes</h2>
                    <table>
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>INVALID_SIGNATURE</code></td>
                                <td>Signature verification failed</td>
                            </tr>
                            <tr>
                                <td><code>INVALID_MERCHANT</code></td>
                                <td>Merchant not found or invalid</td>
                            </tr>
                            <tr>
                                <td><code>INSUFFICIENT_BALANCE</code></td>
                                <td>Insufficient funds for transaction</td>
                            </tr>
                            <tr>
                                <td><code>DUPLICATE_ORDER</code></td>
                                <td>Order ID already exists</td>
                            </tr>
                        </tbody>
                    </table>
                </section>
                <% } %>
    </main>
</body>

</html>