<!DOCTYPE html>
<html lang="<%= currentLang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GaurPay API Documentation</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --bg-body: #f8fafc;
            --bg-sidebar: #ffffff;
            --bg-content: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --code-bg: #f1f5f9;
            --success: #10b981;
            --warning: #f59e0b;
            --error: #ef4444;
            --sidebar-width: 280px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            line-height: 1.6;
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            padding: 1.5rem;
            z-index: 100;
        }

        .logo {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .lang-switch {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            background: var(--bg-body);
            padding: 0.25rem;
            border-radius: 0.5rem;
        }

        .lang-btn {
            flex: 1;
            padding: 0.5rem;
            text-align: center;
            border-radius: 0.375rem;
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-muted);
            text-decoration: none;
            transition: all 0.2s;
        }

        .lang-btn.active {
            background-color: white;
            color: var(--primary);
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
            font-weight: 600;
        }

        .nav-group {
            margin-bottom: 1.5rem;
        }

        .nav-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .nav-link {
            display: block;
            padding: 0.5rem 0.75rem;
            font-size: 0.875rem;
            color: var(--text-main);
            text-decoration: none;
            border-radius: 0.375rem;
            transition: background-color 0.2s;
            margin-bottom: 0.25rem;
        }

        .nav-link:hover {
            background-color: var(--bg-body);
            color: var(--primary);
        }

        .nav-link.active {
            background-color: #eff6ff;
            color: var(--primary);
            font-weight: 500;
        }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 3rem 4rem;
            flex: 1;
            max-width: 1000px;
        }

        section {
            margin-bottom: 4rem;
            scroll-margin-top: 2rem;
        }

        h1 {
            font-size: 2.25rem;
            margin-bottom: 1.5rem;
            color: var(--text-main);
        }

        h2 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--border);
            color: var(--text-main);
        }

        h3 {
            font-size: 1.125rem;
            margin: 1.5rem 0 1rem;
            color: var(--text-main);
        }

        p {
            margin-bottom: 1rem;
            color: var(--text-muted);
        }

        /* Endpoint Badge */
        .endpoint-badge {
            display: inline-flex;
            align-items: center;
            background-color: var(--code-bg);
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
            border: 1px solid var(--border);
        }

        .method {
            font-weight: 700;
            margin-right: 0.75rem;
            text-transform: uppercase;
        }

        .method.post {
            color: var(--success);
        }

        .method.get {
            color: var(--primary);
        }

        .url {
            color: var(--text-main);
        }

        /* Tables & Code */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
            border: 1px solid var(--border);
            border-radius: 0.5rem;
            overflow: hidden;
        }

        th,
        td {
            padding: 0.75rem 1rem;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        th {
            background-color: var(--bg-body);
            font-weight: 600;
            color: var(--text-main);
        }

        td {
            color: var(--text-muted);
        }

        code {
            font-family: 'JetBrains Mono', monospace;
            background-color: var(--code-bg);
            padding: 0.2rem 0.4rem;
            border-radius: 0.25rem;
            font-size: 0.8em;
            color: var(--primary);
        }

        .required {
            color: var(--error);
            font-size: 0.75rem;
            font-weight: 500;
            background: #fef2f2;
            padding: 2px 6px;
            border-radius: 4px;
            margin-left: 0.5rem;
        }

        .optional {
            color: var(--text-muted);
            font-size: 0.75rem;
            font-weight: 500;
            background: #f1f5f9;
            padding: 2px 6px;
            border-radius: 4px;
            margin-left: 0.5rem;
        }

        pre {
            background-color: #1e293b;
            color: #f8fafc;
            padding: 1.5rem;
            border-radius: 0.5rem;
            overflow-x: auto;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.875rem;
            margin-bottom: 1.5rem;
            position: relative;
        }

        pre code {
            background: none;
            color: inherit;
            padding: 0;
            font-size: inherit;
        }

        .copy-btn {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            cursor: pointer;
            font-size: 0.75rem;
            transition: background 0.2s;
        }

        .copy-btn:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        .alert {
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
            border-left: 4px solid;
        }

        .alert-info {
            background-color: #eff6ff;
            border-color: var(--primary);
            color: #1e40af;
        }

        .alert-warning {
            background-color: #fefce8;
            border-color: var(--warning);
            color: #854d0e;
        }

        @media (max-width: 1024px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s;
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
                padding: 2rem;
            }
        }
    </style>
</head>

<body>
    <script>
        const currentLang = '<%= currentLang %>';
        function setLang(lang) {
            const url = new URL(window.location);
            url.searchParams.set('lang', lang);
            window.location.href = url.toString();
        }
        function copyCode(btn) {
            const code = btn.parentElement.querySelector('code').innerText;
            navigator.clipboard.writeText(code);
            const original = btn.innerHTML;
            btn.innerHTML = currentLang === 'zh' ? '已复制！' : 'Copied!';
            setTimeout(() => btn.innerHTML = original, 2000);
        }
    </script>

    <aside class="sidebar">
        <div class="logo">
            <i class="fas fa-layer-group"></i> GaurPay API
        </div>
        <div class="lang-switch">
            <a href="?lang=en" class="lang-btn <%= currentLang === 'en' ? 'active' : '' %>">English</a>
            <a href="?lang=zh" class="lang-btn <%= currentLang === 'zh' ? 'active' : '' %>">中文</a>
        </div>
        <nav>
            <div class="nav-group">
                <div class="nav-title">
                    <%= currentLang==='zh' ? '概览' : 'Overview' %>
                </div>
                <a href="#intro" class="nav-link">
                    <%= currentLang==='zh' ? '简介' : 'Introduction' %>
                </a>
                <a href="#auth" class="nav-link">
                    <%= currentLang==='zh' ? '身份验证' : 'Authentication' %>
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-title">
                    <%= currentLang==='zh' ? '收款 API' : 'Payin API' %>
                </div>
                <a href="#payin-create" class="nav-link">
                    <%= currentLang==='zh' ? '创建订单' : 'Create Order' %>
                </a>
                <a href="#payin-query" class="nav-link">
                    <%= currentLang==='zh' ? '查询订单' : 'Query Order' %>
                </a>
                <a href="#payin-callback" class="nav-link">
                    <%= currentLang==='zh' ? '收款回调' : 'Payin Callback' %>
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-title">
                    <%= currentLang==='zh' ? '代付 API' : 'Payout API' %>
                </div>
                <a href="#payout-bank" class="nav-link">
                    <%= currentLang==='zh' ? '银行代付' : 'Bank Transfer' %>
                </a>
                <a href="#payout-query" class="nav-link">
                    <%= currentLang==='zh' ? '查询代付' : 'Query Payout' %>
                </a>
                <a href="#payout-callback" class="nav-link">
                    <%= currentLang==='zh' ? '代付回调' : 'Payout Callback' %>
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-title">
                    <%= currentLang==='zh' ? '账户' : 'Account' %>
                </div>
                <a href="#balance" class="nav-link">
                    <%= currentLang==='zh' ? '查询余额' : 'Check Balance' %>
                </a>
                <a href="#errors" class="nav-link">
                    <%= currentLang==='zh' ? '错误代码' : 'Error Codes' %>
                </a>
            </div>
        </nav>
    </aside>

    <main class="main-content">
        <!-- ==================== ZH Content (Simplified for brevity in template logic) ==================== -->
        <% if (currentLang==='zh' ) { %>
            <section id="intro">
                <h1>GaurPay API 文档</h1>
                <p>欢迎使用 GaurPay 支付网关。本文档提供安全、可靠的 API 集成指南。</p>
                <div class="alert alert-info">
                    <strong>基础 URL:</strong> <code>https://gaurpay.site</code><br>
                    所有请求均需使用 HTTPS 和 <code>Content-Type: application/json</code>。
                </div>
            </section>

            <section id="auth">
                <h2>身份验证</h2>
                <p>所有接口请求必须包含以下 Header：</p>
                <table>
                    <thead>
                        <tr>
                            <th>Header</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>x-merchant-id</code></td>
                            <td>您的商户 API ID</td>
                        </tr>
                        <tr>
                            <td><code>x-signature</code></td>
                            <td>参数签名的 MD5 哈希值</td>
                        </tr>
                    </tbody>
                </table>
                <h3>签名算法</h3>
                <p>1. 将所有非空参数（不含 <code>sign</code>）按键名 ASCII 升序排列。<br>
                    2. 拼接为 <code>key=value&key2=value2</code> 格式。<br>
                    3. 末尾追加 <code>&secret=YOUR_SECRET_KEY</code>。<br>
                    4. 计算 MD5 哈希并转为<strong>大写</strong>。</p>
            </section>

            <section id="payin-create">
                <h2>创建收款订单</h2>
                <div class="endpoint-badge"><span class="method post">POST</span><span
                        class="url">/api/payin/create</span></div>
                <h3>请求参数</h3>
                <table>
                    <thead>
                        <tr>
                            <th>参数</th>
                            <th>类型</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>orderId</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>商户唯一订单号</td>
                        </tr>
                        <tr>
                            <td><code>orderAmount</code></td>
                            <td>Number<span class="required">必填</span></td>
                            <td>金额 (最低 ₹100.00)</td>
                        </tr>
                        <tr>
                            <td><code>customerName</code></td>
                            <td>String<span class="optional">可选</span></td>
                            <td>客户姓名</td>
                        </tr>
                        <tr>
                            <td><code>customerEmail</code></td>
                            <td>String<span class="optional">可选</span></td>
                            <td>客户邮箱</td>
                        </tr>
                        <tr>
                            <td><code>customerPhone</code></td>
                            <td>String<span class="optional">可选</span></td>
                            <td>客户电话</td>
                        </tr>
                        <tr>
                            <td><code>callbackUrl</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>异步通知地址</td>
                        </tr>
                        <tr>
                            <td><code>returnUrl</code></td>
                            <td>String<span class="optional">可选</span></td>
                            <td>同步跳转地址</td>
                        </tr>
                        <tr>
                            <td><code>param</code></td>
                            <td>String<span class="optional">可选</span></td>
                            <td>透传参数</td>
                        </tr>
                    </tbody>
                </table>
                <h3>响应示例</h3>
                <pre><code>{
    "status": "success",
    "message": "Order created successfully",
    "timestamp": "2026-02-10T10:00:00.000Z",
    "result": {
        "merchantOrderId": "ORD_123456789",
        "platformOrderId": "a1b2c3d4-...",
        "requestedAmount": 500.00,
        "processingFee": 25.00,
        "paymentUrl": "https://gaurpay.site/pay/..."
    }
}</code></pre>
            </section>

            <section id="payin-query">
                <h2>查询收款订单</h2>
                <div class="endpoint-badge"><span class="method post">POST</span><span
                        class="url">/api/payin/query</span></div>
                <h3>请求参数</h3>
                <table>
                    <thead>
                        <tr>
                            <th>参数</th>
                            <th>类型</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>orderId</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>商户订单号</td>
                        </tr>
                    </tbody>
                </table>
                <h3>响应示例</h3>
                <pre><code>{
    "status": "success",
    "result": {
        "merchantOrderId": "ORD_123456789",
        "orderStatus": "success",
        "requestedAmount": 500.00,
        "settledAmount": 475.00,
        "transactionRef": "UTR123456"
    }
}</code></pre>
            </section>

            <section id="payin-callback">
                <h2>收款回调 (Webhook)</h2>
                <p>当订单状态变更（成功或失败）时，我们将向您的 <code>callbackUrl</code> 发送 POST 请求。</p>
                <h3>回调参数</h3>
                <pre><code>{
    "orderId": "ORD_123456789",
    "amount": "500.00",
    "status": "SUCCESS",
    "utr": "UTR123456",
    "param": "custom_data",
    "sign": "ABC123..."
}</code></pre>
                <div class="alert alert-warning"><strong>注意：</strong>收到回调后请校验签名，并返回字符串 <code>SUCCESS</code> 以确认接收。</div>
            </section>

            <section id="payout-bank">
                <h2>银行代付</h2>
                <div class="endpoint-badge"><span class="method post">POST</span><span
                        class="url">/api/payout/bank</span></div>
                <h3>请求参数</h3>
                <table>
                    <thead>
                        <tr>
                            <th>参数</th>
                            <th>类型</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>orderId</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>商户唯一订单号</td>
                        </tr>
                        <tr>
                            <td><code>amount</code></td>
                            <td>Number<span class="required">必填</span></td>
                            <td>代付金额</td>
                        </tr>
                        <tr>
                            <td><code>account</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>银行账号</td>
                        </tr>
                        <tr>
                            <td><code>ifsc</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>IFSC 代码</td>
                        </tr>
                        <tr>
                            <td><code>personName</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>收款人姓名</td>
                        </tr>
                        <tr>
                            <td><code>callbackUrl</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>回调地址</td>
                        </tr>
                        <tr>
                            <td><code>param</code></td>
                            <td>String<span class="optional">可选</span></td>
                            <td>透传参数</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section id="payout-query">
                <h2>查询代付状态</h2>
                <div class="endpoint-badge"><span class="method post">POST</span><span
                        class="url">/api/payout/query</span></div>
                <h3>请求参数</h3>
                <table>
                    <thead>
                        <tr>
                            <th>参数</th>
                            <th>类型</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>orderId</code></td>
                            <td>String<span class="required">必填</span></td>
                            <td>商户订单号</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section id="payout-callback">
                <h2>代付回调</h2>
                <p>代付完成后，向 <code>callbackUrl</code> 推送结果。</p>
                <pre><code>{
    "orderId": "POUT_001",
    "amount": "1000.00",
    "status": "SUCCESS",
    "utr": "UTR998877",
    "sign": "XYZ789..."
}</code></pre>
            </section>

            <section id="balance">
                <h2>查询余额</h2>
                <div class="endpoint-badge"><span class="method post">POST</span><span
                        class="url">/api/balance/query</span></div>
                <p>查询当前商户账户的可用余额和冻结金额。</p>
                <p>无请求参数，仅需签名验证。</p>
                <h3>响应示例</h3>
                <pre><code>{
    "status": "success",
    "result": {
        "availableBalance": 50000.00,
        "pendingBalance": 2000.00,
        "totalBalance": 52000.00,
        "currency": "INR"
    }
}</code></pre>
            </section>
            <section id="errors">
                <h2>错误代码</h2>
                <table>
                    <thead>
                        <tr>
                            <th>代码</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>INVALID_SIGNATURE</code></td>
                            <td>签名无效</td>
                        </tr>
                        <tr>
                            <td><code>INVALID_MERCHANT</code></td>
                            <td>商户无效或未激活</td>
                        </tr>
                        <tr>
                            <td><code>INSUFFICIENT_BALANCE</code></td>
                            <td>余额不足无法代付</td>
                        </tr>
                        <tr>
                            <td><code>SERVICE_SUSPENDED</code></td>
                            <td>商户服务已暂停</td>
                        </tr>
                        <tr>
                            <td><code>DUPLICATE_ORDER</code></td>
                            <td>订单号重复</td>
                        </tr>
                        <tr>
                            <td><code>INVALID_PARAMS</code></td>
                            <td>参数缺失或格式错误</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <% } else { %>
                <!-- ==================== EN Content ==================== -->
                <section id="intro">
                    <h1>GaurPay API Documentation</h1>
                    <p>Welcome to the GaurPay Payment Gateway API. This documentation provides a comprehensive guide to
                        integrating our secure payment solutions for deposits (Pay-In) and withdrawals (Pay-Out).</p>
                    <div class="alert alert-info">
                        <strong>Base URL:</strong> <code>https://gaurpay.site</code><br>
                        All API requests must be made over HTTPS with <code>Content-Type: application/json</code>.
                    </div>
                </section>

                <section id="auth">
                    <h2>Authentication</h2>
                    <p>All API requests are authenticated via HTTP Headers.</p>
                    <table>
                        <thead>
                            <tr>
                                <th>Header Name</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>x-merchant-id</code></td>
                                <td>Your unique Merchant API Key</td>
                            </tr>
                            <tr>
                                <td><code>x-signature</code></td>
                                <td>MD5 hash signature of request parameters</td>
                            </tr>
                        </tbody>
                    </table>
                    <h3>Signature Generation Algorithm</h3>
                    <ol style="margin-left: 1.5rem; color: var(--text-muted); margin-bottom: 1.5rem;">
                        <li>Sort all request body parameters alphabetically by key (ASCII ascending).<br><em>Exclude
                                empty values and the <code>sign</code> parameter.</em></li>
                        <li>Concatenate them into a string: <code>key1=value1&key2=value2</code>.</li>
                        <li>Append your secret key: <code>&secret=YOUR_MERCHANT_SECRET_KEY</code>.</li>
                        <li>Generate the MD5 hash of this string and convert it to <strong>UPPERCASE</strong>.</li>
                    </ol>
                </section>

                <section id="payin-create">
                    <h2>Create Collection Order</h2>
                    <p>Generate a payment link to accept payments from customers.</p>
                    <div class="endpoint-badge"><span class="method post">POST</span><span
                            class="url">/api/payin/create</span></div>

                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>orderId</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Unique Merchant Order ID</td>
                            </tr>
                            <tr>
                                <td><code>orderAmount</code></td>
                                <td>Number<span class="required">Required</span></td>
                                <td>Transaction Amount (Min ₹100.00)</td>
                            </tr>
                            <tr>
                                <td><code>customerName</code></td>
                                <td>String<span class="optional">Optional</span></td>
                                <td>Customer's Full Name</td>
                            </tr>
                            <tr>
                                <td><code>customerEmail</code></td>
                                <td>String<span class="optional">Optional</span></td>
                                <td>Customer's Email Address</td>
                            </tr>
                            <tr>
                                <td><code>customerPhone</code></td>
                                <td>String<span class="optional">Optional</span></td>
                                <td>Customer's Phone Number</td>
                            </tr>
                            <tr>
                                <td><code>callbackUrl</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Webhook URL for payment notifications</td>
                            </tr>
                            <tr>
                                <td><code>returnUrl</code></td>
                                <td>String<span class="optional">Optional</span></td>
                                <td>Redirect URL after successful payment</td>
                            </tr>
                            <tr>
                                <td><code>param</code></td>
                                <td>String<span class="optional">Optional</span></td>
                                <td>Custom pass-through data</td>
                            </tr>
                        </tbody>
                    </table>

                    <h3>Success Response</h3>
                    <button class="copy-btn" onclick="copyCode(this)">Copy</button>
                    <pre><code>{
    "status": "success",
    "message": "Order created successfully",
    "timestamp": "2026-02-10T10:00:00.000Z",
    "result": {
        "merchantOrderId": "ORD_123456789",
        "platformOrderId": "a1b2c3d4-e5f6-...",
        "requestedAmount": 500.00,
        "processingFee": 25.00,
        "paymentUrl": "https://gaurpay.site/pay/a1b2c3d4...",
        "expiresIn": 1800
    }
}</code></pre>
                </section>

                <section id="payin-query">
                    <h2>Query Collection Status</h2>
                    <p>Check the real-time status of a collection order.</p>
                    <div class="endpoint-badge"><span class="method post">POST</span><span
                            class="url">/api/payin/query</span></div>
                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>orderId</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Merchant Order ID</td>
                            </tr>
                        </tbody>
                    </table>
                    <h3>Response Example</h3>
                    <pre><code>{
    "status": "success",
    "timestamp": "2026-02-10T10:05:00.000Z",
    "result": {
        "merchantOrderId": "ORD_123456789",
        "orderStatus": "success",
        "requestedAmount": 500.00,
        "settledAmount": 475.00,
        "transactionRef": "UTR1234567890",
        "createdAt": "2026-02-10T10:00:00.000Z"
    }
}</code></pre>
                </section>

                <section id="payin-callback">
                    <h2>Collection Callback (Webhook)</h2>
                    <p>We send a POST request to your <code>callbackUrl</code> when the order status changes (e.g., to
                        SUCCESS or FAILED).</p>
                    <h3>Callback Payload</h3>
                    <pre><code>{
    "orderId": "ORD_123456789",
    "amount": "500.00",
    "status": "SUCCESS",
    "utr": "UTR1234567890",
    "param": "your_custom_data",
    "sign": "A1B2C3D4E5F6..."
}</code></pre>
                    <div class="alert alert-warning">
                        <strong>Acknowledgement:</strong> Your server must verify the signature and return the plain
                        text string <code>SUCCESS</code> to acknowledge receipt.
                    </div>
                </section>

                <section id="payout-bank">
                    <h2>Bank Transfer (Payout)</h2>
                    <p>Initiate a direct bank transfer (IMPS/NEFT).</p>
                    <div class="endpoint-badge"><span class="method post">POST</span><span
                            class="url">/api/payout/bank</span></div>
                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>orderId</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Unique Merchant Order ID</td>
                            </tr>
                            <tr>
                                <td><code>amount</code></td>
                                <td>Number<span class="required">Required</span></td>
                                <td>Transfer Amount (INR)</td>
                            </tr>
                            <tr>
                                <td><code>account</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Beneficiary Bank Account Number</td>
                            </tr>
                            <tr>
                                <td><code>ifsc</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Bank IFSC Code</td>
                            </tr>
                            <tr>
                                <td><code>personName</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Beneficiary Name</td>
                            </tr>
                            <tr>
                                <td><code>callbackUrl</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Webhook URL for status updates</td>
                            </tr>
                            <tr>
                                <td><code>param</code></td>
                                <td>String<span class="optional">Optional</span></td>
                                <td>Custom pass-through data</td>
                            </tr>
                        </tbody>
                    </table>
                </section>



                <section id="payout-query">
                    <h2>Query Transfer Status</h2>
                    <div class="endpoint-badge"><span class="method post">POST</span><span
                            class="url">/api/payout/query</span></div>
                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>orderId</code></td>
                                <td>String<span class="required">Required</span></td>
                                <td>Merchant Order ID</td>
                            </tr>
                        </tbody>
                    </table>
                    <h3>Response Example</h3>
                    <pre><code>{
    "code": 1,
    "data": {
        "orderId": "POUT_001",
        "status": "success",
        "amount": 1000.00,
        "utr": "UTR998877",
        "createdAt": "2026-02-10T10:00:00.000Z"
    }
}</code></pre>
                </section>

                <section id="payout-callback">
                    <h2>Transfer Callback</h2>
                    <p>Notification sent to <code>callbackUrl</code> when the payout succeeds or fails.</p>
                    <pre><code>{
    "orderId": "POUT_001",
    "amount": "1000.00",
    "status": "SUCCESS",
    "utr": "UTR998877",
    "sign": "XYZ789..."
}</code></pre>
                </section>

                <section id="balance">
                    <h2>Check Balance</h2>
                    <div class="endpoint-badge"><span class="method post">POST</span><span
                            class="url">/api/balance/query</span></div>
                    <p>Retrieve the current Available and Pending balance of the merchant account.</p>
                    <h3>Success Response</h3>
                    <pre><code>{
    "status": "success",
    "timestamp": "2026-02-10T11:00:00.000Z",
    "result": {
        "availableBalance": 50000.00,
        "pendingBalance": 2000.00,
        "totalBalance": 52000.00,
        "currency": "INR"
    }
}</code></pre>
                </section>

                <section id="errors">
                    <h2>Error Codes</h2>
                    <table>
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>INVALID_SIGNATURE</code></td>
                                <td>Signature verification failed</td>
                            </tr>
                            <tr>
                                <td><code>INVALID_MERCHANT</code></td>
                                <td>Merchant ID not found or inactive</td>
                            </tr>
                            <tr>
                                <td><code>INSUFFICIENT_BALANCE</code></td>
                                <td>Insufficient funds for payout transaction</td>
                            </tr>
                            <tr>
                                <td><code>SERVICE_SUSPENDED</code></td>
                                <td>Merchant service has been suspended</td>
                            </tr>
                            <tr>
                                <td><code>DUPLICATE_ORDER</code></td>
                                <td>Order ID already exists</td>
                            </tr>
                            <tr>
                                <td><code>INVALID_PARAMS</code></td>
                                <td>Missing or invalid parameters</td>
                            </tr>
                        </tbody>
                    </table>
                </section>
                <% } %>
    </main>
</body>

</html>