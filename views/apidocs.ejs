    <script>
        function copyCode(btn){
            const code=btn.parentElement.querySelector('code').innerText;
            navigator.clipboard.writeText(code).then(()=>{
                const o=btn.textContent;btn.textContent='<%= currentLang==="zh"?"已复制！":"Copied!" %>';
                setTimeout(()=>btn.textContent=o,2000);
            });
        }
        // Scrollspy
        const secs=document.querySelectorAll('section');
        const links=document.querySelectorAll('.sb a.nl');
        document.querySelector('.main').addEventListener('scroll',()=>{
            let cur='';secs.forEach(s=>{if(s.getBoundingClientRect().top<=180)cur=s.id;});
            links.forEach(l=>{l.classList.toggle('on',l.getAttribute('href')==='#'+cur);});
        });
    </script>
