<!DOCTYPE html>
<html lang="<%= currentLang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>API Documentation - Gaur Pay</title>
    <!-- Fonts & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap"
        rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/prism.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #2B5797;
            --primary-light: #e0e7ff;
            --sidebar-bg: #f8fafc;
            --border: #e2e8f0;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --code-bg: #1e293b;
            --success: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: white;
            color: var(--text-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar */
        .sidebar {
            width: 280px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            padding: 1.5rem;
            height: 100%;
            overflow-y: auto;
            flex-shrink: 0;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 700;
            font-size: 1.25rem;
            margin-bottom: 2rem;
            color: var(--primary);
            text-decoration: none;
        }

        .nav-section {
            margin-bottom: 2rem;
        }

        .nav-title {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            font-weight: 700;
            margin-bottom: 0.75rem;
        }

        .nav-link {
            display: block;
            padding: 0.5rem 0.75rem;
            color: var(--text-main);
            text-decoration: none;
            font-size: 0.875rem;
            border-radius: 0.375rem;
            margin-bottom: 0.125rem;
            font-weight: 500;
            transition: all 0.2s;
        }

        .nav-link:hover {
            background: var(--primary-light);
            color: var(--primary);
        }

        .lang-switch {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
        }

        .lang-btn {
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            background: white;
            border: 1px solid var(--border);
            font-size: 0.75rem;
            cursor: pointer;
            text-decoration: none;
            color: var(--text-main);
        }

        .lang-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        /* Main Content */
        .content {
            flex: 1;
            padding: 3rem 6rem;
            overflow-y: auto;
            scroll-behavior: smooth;
        }

        section {
            margin-bottom: 4rem;
            max-width: 800px;
        }

        h1 {
            font-size: 2.25rem;
            margin-bottom: 1.5rem;
        }

        h2 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            margin-top: 2rem;
            border-bottom: 1px solid var(--border);
            padding-bottom: 0.5rem;
        }

        h3 {
            font-size: 1.125rem;
            margin-bottom: 0.75rem;
            margin-top: 1.5rem;
            color: var(--primary);
        }

        p {
            line-height: 1.6;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .endpoint {
            background: #f1f5f9;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-family: 'Fira Code', monospace;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .method {
            color: #059669;
            margin-right: 0.5rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
        }

        th,
        td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }

        th {
            background: #f8fafc;
            color: var(--text-muted);
            font-weight: 600;
        }

        code:not([class*="language-"]) {
            background: #f1f5f9;
            padding: 0.2rem 0.4rem;
            border-radius: 0.25rem;
            font-family: 'Fira Code', monospace;
            font-size: 0.85em;
            color: #e11d48;
        }

        .alert {
            padding: 1rem;
            border-radius: 0.5rem;
            background: #EFF6FF;
            border-left: 4px solid var(--primary);
            color: #1e40af;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
        }

        .alert-warning {
            background: #FEF3C7;
            border-left-color: var(--warning);
            color: #92400E;
        }

        .alert-success {
            background: #ECFDF5;
            border-left-color: var(--success);
            color: #065F46;
        }

        .required {
            color: #EF4444;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .optional {
            color: #6B7280;
            font-size: 0.75rem;
        }

        pre[class*="language-"] {
            border-radius: 0.75rem;
            margin-bottom: 1.5rem;
            font-size: 0.85rem;
        }

        @media (max-width: 1024px) {
            .sidebar {
                transform: translateX(-100%);
                position: fixed;
                z-index: 100;
                transition: 0.3s;
            }

            .sidebar.show {
                transform: translateX(0);
            }

            .content {
                padding: 2rem;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">
        <a href="/" class="logo">
            <i class="ri-rocket-2-fill"></i>
            Gaur Pay
        </a>

        <div class="lang-switch">
            <a href="?lang=en" class="lang-btn <%= currentLang === 'en' ? 'active' : '' %>">English</a>
            <a href="?lang=zh" class="lang-btn <%= currentLang === 'zh' ? 'active' : '' %>">中文</a>
        </div>

        <div class="nav-section">
            <div class="nav-title">GUIDE</div>
            <a href="#intro" class="nav-link">Introduction</a>
            <a href="#auth" class="nav-link">Authentication</a>
            <a href="#errors" class="nav-link">Response Format</a>
        </div>

        <div class="nav-section">
            <div class="nav-title">COLLECTION (PAY-IN)</div>
            <a href="#collection-initiate" class="nav-link">Initiate Collection</a>
            <a href="#collection-status" class="nav-link">Query Status</a>
            <a href="#collection-update-ref" class="nav-link">Update Reference</a>
            <a href="#collection-callback" class="nav-link">Callback</a>
        </div>

        <div class="nav-section">
            <div class="nav-title">TRANSFER (PAY-OUT)</div>
            <a href="#transfer-bank" class="nav-link">Bank Transfer</a>
            <a href="#transfer-status" class="nav-link">Query Status</a>
            <a href="#transfer-callback" class="nav-link">Callback</a>
        </div>

        <div class="nav-section">
            <div class="nav-title">ACCOUNT</div>
            <a href="#balance" class="nav-link">Check Balance</a>
        </div>
    </aside>

    <main class="content">
        <% if (currentLang==='zh' ) { %>
            <!-- CHINESE CONTENT -->
            <section id="intro">
                <h1>API 文档 v2</h1>
                <p>欢迎使用 Gaur Pay 支付网关 API v2。本文档提供了集成我们安全支付解决方案的全面指南。</p>
                <div class="alert">
                    <strong>版本:</strong> 2.0 | <strong>基础 URL:</strong> https://your-domain.com
                </div>
            </section>

            <section id="auth">
                <h2>身份验证</h2>
                <p>所有 API 请求都需要基于 Header 的身份验证。</p>
                <table>
                    <thead>
                        <tr>
                            <th>Header</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>x-merchant-id</code></td>
                            <td>您的唯一商户 API Key</td>
                        </tr>
                        <tr>
                            <td><code>x-signature</code></td>
                            <td>请求正文的 MD5 签名</td>
                        </tr>
                        <tr>
                            <td><code>Content-Type</code></td>
                            <td>application/json</td>
                        </tr>
                    </tbody>
                </table>
                <h3>签名生成</h3>
                <p>1. 将所有参数按键名 ASCII 码升序排序<br>
                    2. 移除空值和 sign 字段<br>
                    3. 使用 & 拼接为 key=value 格式<br>
                    4. 在末尾追加 &secret=您的密钥<br>
                    5. 进行 MD5 哈希并转换为大写</p>
            </section>

            <section id="collection-initiate">
                <h2>创建收款订单</h2>
                <div class="endpoint"><span class="method">POST</span> /v2/collection/initiate</div>
                <table>
                    <thead>
                        <tr>
                            <th>参数</th>
                            <th>类型</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>merchant_order_id</code></td>
                            <td>String <span class="required">必填</span></td>
                            <td>商户唯一订单号 (最大64字符)</td>
                        </tr>
                        <tr>
                            <td><code>amount</code></td>
                            <td>Number <span class="required">必填</span></td>
                            <td>收款金额 (最小 ₹100)</td>
                        </tr>
                        <tr>
                            <td><code>notify_url</code></td>
                            <td>String <span class="required">必填</span></td>
                            <td>回调通知地址</td>
                        </tr>
                        <tr>
                            <td><code>redirect_url</code></td>
                            <td>String <span class="optional">可选</span></td>
                            <td>支付成功跳转地址</td>
                        </tr>
                        <tr>
                            <td><code>extra_data</code></td>
                            <td>String <span class="optional">可选</span></td>
                            <td>自定义数据 (回调时返回)</td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <% } else { %>
                <!-- ENGLISH CONTENT -->
                <section id="intro">
                    <h1>API Documentation v2</h1>
                    <p>Welcome to the Gaur Pay API v2. This documentation provides a comprehensive guide to integrating
                        our secure payment solutions for collections (pay-in) and transfers (pay-out).</p>
                    <div class="alert">
                        <strong>Version:</strong> 2.0 | <strong>Content-Type:</strong> application/json
                    </div>
                </section>

                <section id="auth">
                    <h2>Authentication</h2>
                    <p>All API requests require header-based authentication with HMAC-MD5 signatures.</p>
                    <table>
                        <thead>
                            <tr>
                                <th>Header</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>x-merchant-id</code></td>
                                <td>Your unique Merchant API Key</td>
                            </tr>
                            <tr>
                                <td><code>x-signature</code></td>
                                <td>MD5 signature of sorted request body + secret</td>
                            </tr>
                            <tr>
                                <td><code>Content-Type</code></td>
                                <td>application/json</td>
                            </tr>
                        </tbody>
                    </table>
                    <h3>Signature Generation</h3>
                    <pre><code class="language-javascript">const crypto = require('crypto');

function generateSignature(params, secretKey) {
    // 1. Filter out empty values and 'sign' key
    const filtered = {};
    Object.keys(params).forEach(key => {
        if (key !== 'sign' && params[key] !== '' && params[key] != null) {
            filtered[key] = params[key];
        }
    });
    // 2. Sort keys alphabetically
    const sorted = Object.keys(filtered).sort();
    // 3. Build query string
    const query = sorted.map(k => `${k}=${filtered[k]}`).join('&');
    // 4. Append secret and hash
    const str = `${query}&secret=${secretKey}`;
    return crypto.createHash('md5').update(str).digest('hex').toUpperCase();
}</code></pre>
                </section>

                <section id="errors">
                    <h2>Response Format</h2>
                    <p>All API responses follow a standardized structure:</p>
                    <pre><code class="language-json">{
    "success": true,
    "code": "SUCCESS",
    "message": "Operation completed successfully",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "data": { ... }
}</code></pre>
                    <h3>Error Response</h3>
                    <pre><code class="language-json">{
    "success": false,
    "code": "ERROR_CODE",
    "message": "Error description",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "errors": [
        { "field": "amount", "message": "Amount is required" }
    ]
}</code></pre>
                    <h3>Error Codes</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>MISSING_PARAMS</td>
                                <td>Required parameters are missing</td>
                            </tr>
                            <tr>
                                <td>INVALID_SIGNATURE</td>
                                <td>Signature verification failed</td>
                            </tr>
                            <tr>
                                <td>INVALID_MERCHANT</td>
                                <td>Invalid merchant ID</td>
                            </tr>
                            <tr>
                                <td>DUPLICATE_ORDER</td>
                                <td>Order ID already exists</td>
                            </tr>
                            <tr>
                                <td>ORDER_NOT_FOUND</td>
                                <td>Order not found</td>
                            </tr>
                            <tr>
                                <td>INSUFFICIENT_BALANCE</td>
                                <td>Not enough balance for transfer</td>
                            </tr>
                            <tr>
                                <td>SUSPENDED</td>
                                <td>Service temporarily suspended</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <section id="collection-initiate">
                    <h2>Initiate Collection</h2>
                    <p>Create a new collection order to receive payment from a customer.</p>
                    <div class="endpoint"><span class="method">POST</span> /v2/collection/initiate</div>
                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>merchant_order_id</code></td>
                                <td>String <span class="required">Required</span></td>
                                <td>Your unique order ID (max 64 chars)</td>
                            </tr>
                            <tr>
                                <td><code>amount</code></td>
                                <td>Number <span class="required">Required</span></td>
                                <td>Amount in INR (min ₹100)</td>
                            </tr>
                            <tr>
                                <td><code>notify_url</code></td>
                                <td>String <span class="required">Required</span></td>
                                <td>URL for async payment notifications</td>
                            </tr>
                            <tr>
                                <td><code>redirect_url</code></td>
                                <td>String <span class="optional">Optional</span></td>
                                <td>Redirect URL after payment</td>
                            </tr>
                            <tr>
                                <td><code>extra_data</code></td>
                                <td>String <span class="optional">Optional</span></td>
                                <td>Custom data (returned in callback)</td>
                            </tr>
                            <tr>
                                <td><code>customer_name</code></td>
                                <td>String <span class="optional">Optional</span></td>
                                <td>Customer name</td>
                            </tr>
                            <tr>
                                <td><code>customer_phone</code></td>
                                <td>String <span class="optional">Optional</span></td>
                                <td>Customer phone number</td>
                            </tr>
                            <tr>
                                <td><code>customer_email</code></td>
                                <td>String <span class="optional">Optional</span></td>
                                <td>Customer email</td>
                            </tr>
                        </tbody>
                    </table>
                    <h3>Example Request</h3>
                    <pre><code class="language-json">{
    "merchant_order_id": "ORD_123456",
    "amount": 500,
    "notify_url": "https://yoursite.com/webhook",
    "redirect_url": "https://yoursite.com/success",
    "extra_data": "user_123"
}</code></pre>
                    <h3>Success Response</h3>
                    <pre><code class="language-json">{
    "success": true,
    "code": "SUCCESS",
    "message": "Collection initiated",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "data": {
        "merchant_order_id": "ORD_123456",
        "platform_order_id": "uuid-here",
        "amount": 500.00,
        "processing_fee": 25.00,
        "payment_url": "https://your-domain.com/pay/uuid",
        "expires_in": 1800
    }
}</code></pre>
                </section>

                <section id="collection-status">
                    <h2>Query Collection Status</h2>
                    <p>Check the status of a collection order.</p>
                    <div class="endpoint"><span class="method">POST</span> /v2/collection/status</div>
                    <h3>Request</h3>
                    <pre><code class="language-json">{ "merchant_order_id": "ORD_123456" }</code></pre>
                    <h3>Response</h3>
                    <pre><code class="language-json">{
    "success": true,
    "code": "SUCCESS",
    "message": "Order status retrieved",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "data": {
        "merchant_order_id": "ORD_123456",
        "platform_order_id": "uuid-here",
        "status": "completed",
        "amount": 500.00,
        "net_amount": 475.00,
        "processing_fee": 25.00,
        "transaction_ref": "UTR123456789",
        "created_at": "2026-02-01T11:00:00.000Z",
        "completed_at": "2026-02-01T11:15:00.000Z"
    }
}</code></pre>
                </section>

                <section id="collection-update-ref">
                    <h2>Update Transaction Reference</h2>
                    <p>Update the UTR/transaction reference for a collection order.</p>
                    <div class="endpoint"><span class="method">POST</span> /v2/collection/update-ref</div>
                    <h3>Request</h3>
                    <pre><code class="language-json">{
    "merchant_order_id": "ORD_123456",
    "transaction_ref": "NEW_UTR_123456789"
}</code></pre>
                    <h3>Response</h3>
                    <pre><code class="language-json">{
    "success": true,
    "code": "SUCCESS",
    "message": "Transaction reference updated",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "data": {
        "merchant_order_id": "ORD_123456",
        "transaction_ref": "NEW_UTR_123456789"
    }
}</code></pre>
                </section>

                <section id="collection-callback">
                    <h2>Collection Callback</h2>
                    <p>When payment status changes, we POST to your notify_url:</p>
                    <pre><code class="language-json">{
    "event_type": "collection.completed",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "data": {
        "merchant_order_id": "ORD_123456",
        "platform_order_id": "uuid-here",
        "status": "completed",
        "amount": 500.00,
        "net_amount": 475.00,
        "processing_fee": 25.00,
        "transaction_ref": "UTR123456789",
        "extra_data": "user_123"
    },
    "signature": "MD5_SIGNATURE"
}</code></pre>
                    <h3>Event Types</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>collection.completed</code></td>
                                <td>Payment received successfully</td>
                            </tr>
                            <tr>
                                <td><code>collection.failed</code></td>
                                <td>Payment failed or expired</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="alert alert-warning">
                        <strong>Important:</strong> Respond with plain text <code>OK</code> to acknowledge the callback.
                    </div>
                </section>

                <section id="transfer-bank">
                    <h2>Bank Transfer</h2>
                    <p>Transfer funds to a bank account via IMPS/NEFT.</p>
                    <div class="endpoint"><span class="method">POST</span> /v2/transfer/bank</div>
                    <h3>Request Parameters</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Parameter</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>merchant_order_id</code></td>
                                <td>String <span class="required">Required</span></td>
                                <td>Your unique transaction ID</td>
                            </tr>
                            <tr>
                                <td><code>amount</code></td>
                                <td>Number <span class="required">Required</span></td>
                                <td>Amount in INR (min ₹100)</td>
                            </tr>
                            <tr>
                                <td><code>account_number</code></td>
                                <td>String <span class="required">Required</span></td>
                                <td>Bank account number</td>
                            </tr>
                            <tr>
                                <td><code>ifsc_code</code></td>
                                <td>String <span class="required">Required</span></td>
                                <td>IFSC code</td>
                            </tr>
                            <tr>
                                <td><code>beneficiary_name</code></td>
                                <td>String <span class="required">Required</span></td>
                                <td>Account holder name</td>
                            </tr>
                            <tr>
                                <td><code>notify_url</code></td>
                                <td>String <span class="required">Required</span></td>
                                <td>Callback URL for status updates</td>
                            </tr>
                            <tr>
                                <td><code>extra_data</code></td>
                                <td>String <span class="optional">Optional</span></td>
                                <td>Custom data (returned in callback)</td>
                            </tr>
                        </tbody>
                    </table>
                    <h3>Example Request</h3>
                    <pre><code class="language-json">{
    "merchant_order_id": "PO_123456",
    "amount": 10000,
    "account_number": "1234567890123",
    "ifsc_code": "HDFC0001234",
    "beneficiary_name": "John Doe",
    "notify_url": "https://yoursite.com/payout-webhook"
}</code></pre>
                    <h3>Success Response</h3>
                    <pre><code class="language-json">{
    "success": true,
    "code": "SUCCESS",
    "message": "Transfer initiated",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "data": {
        "merchant_order_id": "PO_123456",
        "platform_order_id": "uuid-here",
        "amount": 10000.00,
        "processing_fee": 306.00,
        "status": "processing",
        "estimated_completion": "2026-02-01T12:15:00.000Z"
    }
}</code></pre>
                </section>

                <section id="transfer-status">
                    <h2>Query Transfer Status</h2>
                    <p>Check the status of a transfer order.</p>
                    <div class="endpoint"><span class="method">POST</span> /v2/transfer/status</div>
                    <h3>Request</h3>
                    <pre><code class="language-json">{ "merchant_order_id": "PO_123456" }</code></pre>
                    <h3>Response</h3>
                    <pre><code class="language-json">{
    "success": true,
    "code": "SUCCESS",
    "message": "Transfer status retrieved",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "data": {
        "merchant_order_id": "PO_123456",
        "platform_order_id": "uuid-here",
        "type": "bank",
        "status": "completed",
        "amount": 10000.00,
        "processing_fee": 306.00,
        "transaction_ref": "UTR123456789",
        "beneficiary_name": "John Doe",
        "account_number": "****0123",
        "created_at": "2026-02-01T11:00:00.000Z",
        "completed_at": "2026-02-01T11:10:00.000Z"
    }
}</code></pre>
                </section>

                <section id="transfer-callback">
                    <h2>Transfer Callback</h2>
                    <p>When transfer status changes, we POST to your notify_url:</p>
                    <pre><code class="language-json">{
    "event_type": "transfer.completed",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "data": {
        "merchant_order_id": "PO_123456",
        "platform_order_id": "uuid-here",
        "status": "completed",
        "amount": 10000.00,
        "processing_fee": 306.00,
        "transaction_ref": "UTR123456789",
        "extra_data": "user_123"
    },
    "signature": "MD5_SIGNATURE"
}</code></pre>
                    <h3>Event Types</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><code>transfer.completed</code></td>
                                <td>Transfer completed successfully</td>
                            </tr>
                            <tr>
                                <td><code>transfer.failed</code></td>
                                <td>Transfer failed</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="alert alert-warning">
                        <strong>Important:</strong> Respond with plain text <code>OK</code> to acknowledge the callback.
                    </div>
                </section>

                <section id="balance">
                    <h2>Check Balance</h2>
                    <p>Get your current account balance.</p>
                    <div class="endpoint"><span class="method">POST</span> /v2/account/balance</div>
                    <h3>Request</h3>
                    <pre><code class="language-json">{}</code></pre>
                    <h3>Response</h3>
                    <pre><code class="language-json">{
    "success": true,
    "code": "SUCCESS",
    "message": "Balance retrieved",
    "timestamp": "2026-02-01T12:00:00.000Z",
    "data": {
        "available_balance": 50000.00,
        "pending_balance": 5000.00,
        "total_balance": 55000.00,
        "currency": "INR"
    }
}</code></pre>
                </section>

                <% } %>
    </main>

    <script>
        // Highlight active nav link based on scroll position
        const sections = document.querySelectorAll('section');
        const navLinks = document.querySelectorAll('.nav-link');

        document.querySelector('.content').addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                const rect = section.getBoundingClientRect();
                if (rect.top <= 150) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                link.style.background = '';
                link.style.color = '';
                if (link.getAttribute('href') === '#' + current) {
                    link.style.background = 'var(--primary-light)';
                    link.style.color = 'var(--primary)';
                }
            });
        });
    </script>
</body>

</html>